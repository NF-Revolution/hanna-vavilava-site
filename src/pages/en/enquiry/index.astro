---
import Page from '../../../layouts/Page.astro';
import SubBar from '../../../components/SubBar.astro';
import { t } from '../../../i18n';

const locale = 'en' as const;
const dict = t(locale);
const page = dict.pages.enquiry;
---

<Page locale={locale} routeKey="enquiry" title={page.title} description={page.description}>
  <SubBar label={page.label} />
  <section class="stub">
    <!-- Ticket 5.1 — the eight-field form. -->
    <p class="copy">5.1 — the eight-field form</p>
  </section>
</Page>

<style>
  .stub {
    padding: 80px var(--gutter);
    color: var(--ink-muted);
  }
</style>
