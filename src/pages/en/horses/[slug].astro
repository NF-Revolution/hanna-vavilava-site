---
import HorseDetailStub from '../../../components/HorseDetailStub.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const horses = await getCollection('horses');
  return horses.map((horse) => ({ params: { slug: horse.id }, props: { name: horse.data.name } }));
}

const { slug } = Astro.params;
const { name } = Astro.props;
---

<HorseDetailStub locale="en" slug={slug!} name={name} />
