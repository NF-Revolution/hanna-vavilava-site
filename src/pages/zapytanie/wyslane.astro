---
import Page from '../../layouts/Page.astro';
import SubBar from '../../components/SubBar.astro';
import { t } from '../../i18n';

const locale = 'pl' as const;
const dict = t(locale);
const page = dict.pages.enquirySent;
---

<Page locale={locale} routeKey="enquirySent" title={page.title} description={page.description}>
  <SubBar label={page.label} />
  <section class="stub">
    <!-- Ticket 5.7 — confirmation and the direct contact fallback. -->
    <p class="copy">5.7 — confirmation and the direct contact fallback</p>
  </section>
</Page>

<style>
  .stub {
    padding: 80px var(--gutter);
    color: var(--ink-muted);
  }
</style>
