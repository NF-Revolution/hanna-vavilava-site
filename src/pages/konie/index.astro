---
import Page from '../../layouts/Page.astro';
import SubBar from '../../components/SubBar.astro';
import { t } from '../../i18n';

const locale = 'pl' as const;
const dict = t(locale);
const page = dict.pages.horses;
---

<Page locale={locale} routeKey="horses" title={page.title} description={page.description}>
  <SubBar label={page.label} />
  <section class="stub">
    <!-- Ticket 4.2 — editorial view, four alternating entries. -->
    <p class="copy">4.2 — editorial view, four alternating entries</p>
  </section>
</Page>

<style>
  .stub {
    padding: 80px var(--gutter);
    color: var(--ink-muted);
  }
</style>
