---
import HorseDetailStub from '../../components/HorseDetailStub.astro';
import { site } from '../../site';

export function getStaticPaths() {
  // PLACEHOLDER source — the content collection replaces this in ticket 2.2.
  const horse = site.featuredHorse;
  return [{ params: { slug: horse.slug }, props: { name: horse.name } }];
}

const { slug } = Astro.params;
const { name } = Astro.props;
---

<HorseDetailStub locale="pl" slug={slug!} name={name} />
