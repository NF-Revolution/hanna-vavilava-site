---
import HorseDetailStub from '../../components/HorseDetailStub.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const horses = await getCollection('horses');
  return horses.map((horse) => ({ params: { slug: horse.id }, props: { horse: horse.data } }));
}

const { slug } = Astro.params;
const { horse } = Astro.props;
---

<HorseDetailStub locale="pl" slug={slug!} horse={horse} />
