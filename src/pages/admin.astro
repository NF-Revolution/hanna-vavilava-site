    text-decoration: none;
  }
  ol {
    margin: 0;
    padding-left: 1.5rem;
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1rem;
  }
  [data-status] {
    color: var(--ink-muted);
  }
  #errors:empty,
  #list-error:empty,
  #enquiry-error:empty,
  #refresh-status:empty {
    display: none;
  }
  .actions {
    display: flex;
    gap: 1.5rem;
  }
</style>
