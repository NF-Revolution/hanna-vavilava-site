    font-weight: 600;
  }
  .pair {
    border: 0;
    padding: 0;
  }
  @media (min-width: 40rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
    .pair legend {
      grid-column: 1 / -1;
    }
  }
  label {
    display: grid;
    gap: 0.25rem;
  }
  small {
    color: var(--ink-muted);
  }
  input,
  select,
  textarea {
    min-height: var(--tap);
    border-bottom: 1px solid var(--rule-field);
  }
  textarea {
    border: 1px solid var(--rule-field);
    padding: 0.5rem;
    resize: vertical;
  }
  .confirm {
    grid-template-columns: auto 1fr;
    align-items: center;
  }
  .drop {
    padding: 1.5rem;
    border: 1px dashed var(--rule-field);
  }
  #photos li,
  #xrays li {
    align-items: start;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  #photos img {
    object-fit: cover;
    background: var(--rule);
  }
  .cover-img:not([hidden]) {
    display: block;
    width: 6rem;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: var(--rule);
  }
  #photos .pair,
  #xrays .pair {
    flex: 1 1 20rem;
  }
  .code {
    font-family: ui-monospace, monospace;
