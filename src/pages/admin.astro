---
/*
 * The admin panel (E2.3) — the only client-rendered route. Standalone rather
 * than Base.astro: Base emits canonical, hreflang and og tags for a public
 * route, and this page must be none of those. It is not in routes.ts either,
 * so it has no /en twin and nothing links to it.
 *
 * The horse editor (E2.4) lives here too: a live list to reorder and open,
 * and one form whose field names are dotted paths into the horse. The
 * mapping is `horse-form.ts`; the check before any write is `horseSchema`.
 * Photos (E2.5) upload to Storage as they are dropped, downscaled and
 * stripped of EXIF by `photo.ts`, and join the form as rows of fields.
 * Publish (E2.6) calls the `publish` Function in `functions/` and watches the
 * deploy it starts. The enquiry inbox (E2.7) lives on /admin/zapytania since
 * E2.14; this page only counts the unhandled ones, live. X-ray PDFs (E2.10) go straight to R2 on a
 * presigned PUT from the `xrayUpload` Function, byte for byte, once a tick says
 * page 1 names no private owner; Save deletes the ones the form let go.
 *
 * ponytail: Polish only — one user. The strings exist in en.json too, so an
 * English panel is swapping the locale below if Hanna ever wants one.
 */
import '../styles/fonts.css';
import '../styles/base.css';
import { htmlLang, t } from '../i18n';
import { horseSchema } from '../horse';

const locale = 'pl';
const dict = t(locale);
const a = dict.admin;
const f = a.fields as Record<string, string>;
const o = a.options as Record<string, string>;

/* A field is text, number or date input, a PL/EN pair, PL/EN line lists, JSON, photos, the phone cover, X-ray files, or a select. */
type Kind =
  'text' | 'number' | 'date' | 'pair' | 'lines' | 'json' | 'photos' | 'cover' | 'xrays' | string[];
type Field = [path: string, kind: Kind, required?: boolean];

/* Facts only the starts sync writes (E2.12); the form never shows them. */
const synced = ['lastStart', 'starts'];

const sections: [legend: string, fields: Field[]][] = [
  [
    a.sections.basics,
    [
      ['name', 'text', true],
      ['sex', ['mare', 'gelding']],
      ['born', 'number', true],
      ['heightCm', 'number', true],
      ['breed', 'text'],
      ['pedigree', 'text'],
      ['headline', 'pair'],
      ['description', 'pair'],
    ],
  ],
  [
    a.sections.sale,
    [
      ['status', ['available', 'reserved', 'sold']],
      ['seller', ['company', 'private']],
      ['levelCm', 'number', true],
      ['price', 'number'],
    ],
  ],
  [
    a.sections.facts,
    [
      ['livejumpingName', 'text'],
      ...Object.keys(horseSchema.shape.facts.shape)
        .filter((k) => !synced.includes(k))
        .map((k): Field => [`facts.${k}`, 'pair']),
    ],
  ],
  [a.sections.fit, [['suits', 'lines']]],
  [
    a.sections.health,
    [
      ['health.vaccinations', 'pair'],
      ['health.knownIssues', 'pair'],
    ],
  ],
  [
    a.sections.xrays,
    [
      ['xrays.count', 'number'],
      ['xrays.takenOn', 'date'],
      ['xrays.scope', 'pair'],
      ['xrays.files', 'xrays'],
    ],
  ],
  [
    a.sections.media,
    [
      ['videos', 'json'],
      ['photos', 'photos'],
      ['phoneCover', 'cover'],
    ],
  ],
];

/* The description is Hanna's one free text (E4.20), so it gets room to write. */
const rows = (path: string, kind: Kind) => (path === 'description' ? 8 : kind === 'lines' ? 4 : 2);

const hints: Record<string, string> = {
  price: a.priceHint,
  'xrays.count': a.xraysHint,
  livejumpingName: a.livejumpingHint,
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{a.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {dict.a11y.skipToContent}
    </a>
    <main id="main">
      <h1>{a.h1}</h1>

      <form id="sign-in" hidden>
        <label>
          {a.email}
          <input name="email" type="email" autocomplete="username" required />
        </label>
        <label>
          {a.password}
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit">{a.signIn}</button>
        <p id="error" role="alert"></p>
      </form>

      <section id="no-access" hidden>
        <p>{a.noAccess}</p>
        <button type="button" data-sign-out>
          {a.signOut}
        </button>
      </section>

      <section id="shell" hidden>
        <p id="who"></p>
        <button type="button" data-sign-out>
          {a.signOut}
        </button>

        <section id="list-view">
          <section>
            <h2>{a.enquiries}</h2>
            <p id="enquiry-count" role="status"></p>
            <a href="/admin/zapytania">{a.enquiriesOpen}</a>
            <p id="enquiry-error" role="alert"></p>
          </section>

          <h2 id="list-title" tabindex="-1">
            {a.horses}
          </h2>
          <button type="button" id="add">
            {a.add}
          </button>
          <ol id="list"></ol>
          <p id="empty" hidden>
            {a.empty}
          </p>
          <p id="list-error" role="alert"></p>
          <p>
            <button type="button" id="publish">
              {a.publish}
            </button>
            <small>{a.publishHint}</small>
          </p>
          <p id="publish-status" role="status"></p>
          <p>
            <button type="button" id="refresh-starts">
              {a.refreshStarts}
            </button>
            <small>{a.refreshStartsHint}</small>
          </p>
          <ul id="refresh-status" role="status"></ul>
        </section>

        <form id="editor" hidden>
          <h2 id="editor-title" tabindex="-1"></h2>
          <label>
            {f.slug} <small>{a.slugHint}</small>
            <input id="slug" type="text" required pattern="[a-z0-9]+(-[a-z0-9]+)*" />
          </label>

          {sections.map(([legend, fields]) => (
            <fieldset>
              <legend>{legend}</legend>
              {fields.map(([path, kind, required]) =>
                kind === 'pair' || kind === 'lines' ? (
                  <fieldset class="pair">
                    <legend>
                      {f[path]} {kind === 'lines' && <small>{a.lineHint}</small>}
                    </legend>
                    <label>
                      PL
                      <textarea name={`${path}.pl`} rows={rows(path, kind)}></textarea>
                    </label>
                    <label>
                      EN
                      <textarea name={`${path}.en`} lang="en" rows={rows(path, kind)}></textarea>
                    </label>
                  </fieldset>
                ) : kind === 'photos' ? (
                  <fieldset class="photos">
                    <legend>
                      {f[path]} <small>{a.photoHint}</small>{' '}
                      <a href="/admin/poradnik" target="_blank" rel="noopener">
                        {a.guideLink}
                      </a>
                    </legend>
                    <label id="drop" class="drop">
                      {a.photoDrop}
                      <input id="photo-input" type="file" accept="image/*" multiple />
                    </label>
                    <p id="photo-status" role="status"></p>
                    <ol id="photos"></ol>
                  </fieldset>
                ) : kind === 'cover' ? (
                  <fieldset>
                    <legend>
                      {f[path]} <small>{a.phoneCoverHint}</small>
                    </legend>
                    <img id="cover-img" class="cover-img" alt="" width="96" height="171" hidden />
                    <input id="cover-key" type="hidden" name={path} />
                    <label class="drop">
                      {a.phoneCoverDrop}
                      <input id="cover-input" type="file" accept="image/*" />
                    </label>
                    <button id="cover-remove" type="button" hidden>
                      {a.phoneCoverRemove}
                    </button>
                    <p id="cover-status" role="status"></p>
                  </fieldset>
                ) : kind === 'xrays' ? (
                  <fieldset>
                    <legend>
                      {f[path]} <small>{a.xrayHint}</small>{' '}
                      <a href="/admin/poradnik" target="_blank" rel="noopener">
                        {a.guideLink}
                      </a>
                    </legend>
                    <label class="confirm">
                      <input id="xray-confirm" type="checkbox" />
                      {a.xrayConfirm}
                    </label>
                    <label class="drop">
                      {a.xrayDrop}
                      <input
                        id="xray-input"
                        type="file"
                        accept="application/pdf"
                        multiple
                        disabled
                      />
                    </label>
                    <p id="xray-status" role="status"></p>
                    <ol id="xrays"></ol>
                  </fieldset>
                ) : kind === 'json' ? (
                  <label>
                    {f[path]}
                    <textarea name={path} rows={6} spellcheck="false" class="code"></textarea>
                  </label>
                ) : Array.isArray(kind) ? (
                  <label>
                    {f[path]}
                    <select name={path}>
                      {kind.map((value) => (
                        <option value={value}>{o[value]}</option>
                      ))}
                    </select>
                  </label>
                ) : (
                  <label>
                    {f[path]} {hints[path] && <small>{hints[path]}</small>}
                    <input
                      name={path}
                      type={kind}
                      required={required}
                      step={kind === 'number' ? 1 : undefined}
                      min={kind === 'number' && path !== 'born' ? 1 : undefined}
                    />
                  </label>
                ),
              )}
            </fieldset>
          ))}

          <ul id="errors" role="alert"></ul>
          <div class="actions">
            <button type="submit" id="save">
              {a.save}
            </button>
            <button type="button" id="preview">
              {a.preview}
            </button>
            <button type="button" id="cancel">
              {a.cancel}
            </button>
          </div>
          <small>{a.previewHint}</small>
          <p id="preview-status" role="status"></p>
        </form>

        <template id="row">
          <li>
            <span data-name></span>
            <span data-status></span>
            <button type="button" data-edit>
              {a.edit}
            </button>
            <button type="button" data-up>
              ↑
            </button>
            <button type="button" data-down>
              ↓
            </button>
          </li>
        </template>

        <template id="photo-row">
          <li>
            <img alt="" width="160" height="120" />
            <input type="hidden" data-field="key" />
            <fieldset class="pair">
              <legend data-legend></legend>
              <label>
                {a.photoAlt} · PL
                <input type="text" data-field="alt.pl" required />
              </label>
              <label>
                {a.photoAlt} · EN
                <input type="text" data-field="alt.en" lang="en" required />
              </label>
              <label>
                {a.photoCaption} · PL
                <input type="text" data-field="caption.pl" />
              </label>
              <label>
                {a.photoCaption} · EN
                <input type="text" data-field="caption.en" lang="en" />
              </label>
            </fieldset>
            <button type="button" data-up>
              ↑
            </button>
            <button type="button" data-down>
              ↓
            </button>
            <button type="button" data-remove>
              {a.remove.replace(': {name}', '')}
            </button>
          </li>
        </template>

        <template id="xray-row">
          <li>
            <a data-link>PDF</a>
            <input type="hidden" data-field="key" />
            <input type="number" hidden data-field="bytes" />
            <fieldset class="pair">
              <legend data-legend></legend>
              <label>
                {a.xrayLabel} · PL
                <input type="text" data-field="label.pl" />
              </label>
              <label>
                {a.xrayLabel} · EN
                <input type="text" data-field="label.en" lang="en" />
              </label>
            </fieldset>
            <button type="button" data-remove>
              {a.remove.replace(': {name}', '')}
            </button>
          </li>
        </template>
      </section>
    </main>
  </body>
</html>

<script>
  import { initializeApp } from 'firebase/app';
  import {
    getAuth,
    onAuthStateChanged,
    signInWithEmailAndPassword,
    signOut,
    type AuthError,
  } from 'firebase/auth';
  import { getDatabase, onValue, ref, set, update } from 'firebase/database';
  import { getFunctions, httpsCallable } from 'firebase/functions';
  import { getStorage, ref as storageRef, uploadBytes } from 'firebase/storage';
  import { isHandled } from '../enquiry';
  import { firebaseConfig, photoUrl } from '../firebase';
  import { horseSchema } from '../horse';
  import { fromFields, halfPairs, toFields } from '../horse-form';
  import { plural } from '../i18n/format';
  import { path } from '../i18n/routes';
  import { admin } from '../i18n/pl.json';
  import { media, xrayMaxBytes } from '../media';
  import { downscale, photoKey } from '../photo';

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getDatabase(app);
  const storage = getStorage(app);
  const functions = getFunctions(app, 'europe-central2');
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const form = $<HTMLFormElement>('sign-in');
  const error = $('error');
  const noAccess = $('no-access');
  const shell = $('shell');
  const who = $('who');
  const listView = $('list-view');
  const list = $('list');
  const empty = $('empty');
  const listError = $('list-error');
  const row = $<HTMLTemplateElement>('row');
  const editor = $<HTMLFormElement>('editor');
  const editorTitle = $('editor-title');
  const slugInput = $<HTMLInputElement>('slug');
  const errors = $('errors');
  const save = $<HTMLButtonElement>('save');
  const photoList = $('photos');
  const photoRow = $<HTMLTemplateElement>('photo-row');
  const photoStatus = $('photo-status');
  const photoInput = $<HTMLInputElement>('photo-input');
  const xrayList = $('xrays');
  const xrayRow = $<HTMLTemplateElement>('xray-row');
  const xrayStatus = $('xray-status');
  const xrayInput = $<HTMLInputElement>('xray-input');
  const xrayConfirm = $<HTMLInputElement>('xray-confirm');

  const show = (view: HTMLElement | null) => {
    for (const el of [form, noAccess, shell]) el.hidden = el !== view;
  };

  /* The raw records under `/horses`, keyed by slug. Parsed only on save. */
  type Stored = Record<string, any>;
  let horses: Record<string, Stored> = {};
  /* The slug being edited; `null` while creating one. */
  let editing: string | null = null;
  let unsubscribe: (() => void) | undefined;

  const sorted = () =>
    Object.keys(horses).sort(
      (x, y) => (horses[x].order ?? 0) - (horses[y].order ?? 0) || x.localeCompare(y),
    );

  function render() {
    const slugs = sorted();
    list.replaceChildren(
      ...slugs.map((slug, i) => {
        const li = row.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const name = horses[slug].name ?? slug;
        const status = horses[slug].status ?? 'available';
        const button = (key: string) => li.querySelector<HTMLButtonElement>(`[data-${key}]`)!;
        li.querySelector('[data-name]')!.textContent = name;
        li.querySelector('[data-status]')!.textContent =
          admin.options[status as keyof typeof admin.options] ?? status;
        button('edit').setAttribute('aria-label', `${admin.edit}: ${name}`);
        button('edit').onclick = () => open(slug);
        for (const [key, by] of [
          ['up', -1],
          ['down', 1],
        ] as const) {
          button(key).setAttribute('aria-label', admin[key].replace('{name}', name));
          button(key).disabled = !slugs[i + by];
          button(key).onclick = () => move(slugs, i, by);
        }
        return li;
      }),
    );
    empty.hidden = slugs.length > 0;
  }

  /* Rewrites every position as 0..n-1, so horses seeded with the same default can move. */
  function move(slugs: string[], i: number, by: number) {
    const next = [...slugs];
    [next[i], next[i + by]] = [next[i + by], next[i]];
    listError.textContent = '';
    update(
      ref(db, 'horses'),
      Object.fromEntries(next.map((slug, n) => [`${slug}/order`, n])),
    ).catch(() => (listError.textContent = admin.saveFailed));
  }

  const controls = () =>
    [...editor.elements].filter(
      (el): el is HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement =>
        'name' in el && el.name !== '' && 'value' in el,
    );

  /* Names every row's inputs `photos.<i>.…` in display order, the shape `fromFields` reads. */
  function numberPhotos() {
    const rows = [...photoList.children];
    rows.forEach((li, i) => {
      const name = admin.photo.replace('{n}', String(i + 1));
      const button = (key: string) => li.querySelector<HTMLButtonElement>(`[data-${key}]`)!;
      li.querySelector('[data-legend]')!.textContent = name;
      for (const el of li.querySelectorAll<HTMLInputElement>('[data-field]')) {
        el.name = `photos.${i}.${el.dataset.field}`;
      }
      button('up').setAttribute('aria-label', admin.up.replace('{name}', name));
      button('down').setAttribute('aria-label', admin.down.replace('{name}', name));
      button('remove').setAttribute('aria-label', admin.remove.replace('{name}', name));
      button('up').disabled = i === 0;
      button('down').disabled = i === rows.length - 1;
    });
  }

  function addPhoto(photo: { key: string }) {
    const li = photoRow.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    const button = (key: string) => li.querySelector<HTMLButtonElement>(`[data-${key}]`)!;
    li.querySelector('img')!.src = photoUrl(photo.key);
    for (const el of li.querySelectorAll<HTMLInputElement>('[data-field]')) {
      el.value = el.dataset.field!.split('.').reduce((v: any, k) => v?.[k], photo) ?? '';
    }
    // Moving the row drops focus, so it goes back to the pressed button, or its twin at an end.
    const move = (key: 'up' | 'down') => {
      if (key === 'up') li.previousElementSibling?.before(li);
      else li.nextElementSibling?.after(li);
      numberPhotos();
      (button(key).disabled ? button(key === 'up' ? 'down' : 'up') : button(key)).focus();
    };
    button('up').onclick = () => move('up');
    button('down').onclick = () => move('down');
    // ponytail: the Storage object stays — a saved horse may still use it. #23 cleans up on sale.
    button('remove').onclick = () => {
      li.remove();
      numberPhotos();
      photoInput.focus();
    };
    photoList.append(li);
    numberPhotos();
  }

  /* Downscale, which drops the EXIF, then upload under a content hash. Returns the key. */
  async function store(file: File, slug: string) {
    const blob = await downscale(file);
    const key = await photoKey(slug, blob);
    await uploadBytes(storageRef(storage, key), blob, {
      contentType: 'image/jpeg',
      cacheControl: media.cacheControl,
    });
    return key;
  }

  /* The slug names the Storage folder, so no upload goes before it. */
  function slugFor(status: HTMLElement) {
    if (slugInput.value && slugInput.checkValidity()) return slugInput.value;
    status.textContent = admin.photoNeedSlug;
    slugInput.focus();
  }

  /* One file at a time. */
  async function upload(files: FileList | null | undefined) {
    if (!files?.length) return;
    const slug = slugFor(photoStatus);
    if (!slug) return;
    const done: string[] = [];
    const failed: string[] = [];
    for (const file of files) {
      photoStatus.textContent = admin.photoUploading.replace('{name}', file.name);
      try {
        addPhoto({ key: await store(file, slug) });
        done.push(file.name);
      } catch {
        failed.push(file.name);
      }
    }
    photoStatus.textContent = [
      done.length ? admin.photoDone.replace('{count}', String(done.length)) : '',
      ...failed.map((name) => admin.photoFailed.replace('{name}', name)),
    ]
      .filter(Boolean)
      .join(' ');
    photoInput.value = '';
  }

  photoInput.addEventListener('change', () => upload(photoInput.files));

  /*
   * The phone cover (#149): one optional portrait photo, a hidden key and its
   * preview. ponytail: a replaced or removed one stays in Storage, as photos do.
   */
  const coverImg = $<HTMLImageElement>('cover-img');
  const coverKey = $<HTMLInputElement>('cover-key');
  const coverInput = $<HTMLInputElement>('cover-input');
  const coverRemove = $<HTMLButtonElement>('cover-remove');
  const coverStatus = $('cover-status');

  function showCover(key: string) {
    coverKey.value = key;
    coverImg.hidden = coverRemove.hidden = !key;
    if (key) coverImg.src = photoUrl(key);
    else coverImg.removeAttribute('src');
  }

  coverInput.addEventListener('change', async () => {
    const file = coverInput.files?.[0];
    const slug = file && slugFor(coverStatus);
    if (!file || !slug) return;
    coverStatus.textContent = admin.photoUploading.replace('{name}', file.name);
    try {
      showCover(await store(file, slug));
      coverStatus.textContent = admin.photoDone.replace('{count}', '1');
    } catch {
      coverStatus.textContent = admin.photoFailed.replace('{name}', file.name);
    }
    coverInput.value = '';
  });
  coverRemove.addEventListener('click', () => {
    showCover('');
    coverInput.focus();
  });
  $('drop').addEventListener('dragover', (event) => event.preventDefault());
  $('drop').addEventListener('drop', (event) => {
    event.preventDefault();
    upload(event.dataTransfer?.files);
  });

  /*
   * X-ray PDFs (E2.10). The Function builds the key and signs the headers, so the
   * object cannot land without `Content-Disposition: attachment`; the panel only
   * sends the bytes, then reads the key back through the public host once.
   */
  const xrayUpload = httpsCallable<
    { slug: string; takenOn: string; bytes: number },
    { key: string; url: string; headers: Record<string, string> }
  >(functions, 'xrayUpload');
  const xrayDelete = httpsCallable<{ keys: string[] }, void>(functions, 'xrayDelete');
  /* Keys uploaded since the editor opened. Save deletes any the form no longer holds. */
  let uploaded = new Set<string>();

  // The Realtime Database hands a list back as an object once its keys stop being 0..n-1.
  const storedXrays = (): { key: string; bytes: number }[] =>
    Object.values((editing !== null && horses[editing].xrays?.files) || {});

  function numberXrays() {
    [...xrayList.children].forEach((li, i) => {
      const name = admin.xrayFile.replace('{n}', String(i + 1));
      li.querySelector('[data-legend]')!.textContent = name;
      for (const el of li.querySelectorAll<HTMLInputElement>('[data-field]')) {
        el.name = `xrays.files.${i}.${el.dataset.field}`;
      }
      li.querySelector('[data-remove]')!.setAttribute(
        'aria-label',
        admin.remove.replace('{name}', name),
      );
    });
  }

  function addXray(file: { key: string; bytes: number }) {
    const li = xrayRow.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    const link = li.querySelector('a')!;
    link.href = `${media.base}/${file.key}`;
    link.textContent = `PDF · ${(file.bytes / 1024 ** 2).toFixed(1)} MB`;
    for (const el of li.querySelectorAll<HTMLInputElement>('[data-field]')) {
      el.value = el.dataset.field!.split('.').reduce((v: any, k) => v?.[k], file) ?? '';
    }
    // Undone by Cancel; the object goes only when Save writes the horse without it.
    li.querySelector<HTMLButtonElement>('[data-remove]')!.onclick = () => {
      li.remove();
      numberXrays();
      xrayConfirm.focus();
    };
    xrayList.append(li);
    numberXrays();
  }

  async function uploadXrays(files: FileList | null) {
    if (!files?.length) return;
    // The exam date is in the download's filename, so it comes first.
    const takenOn = (editor.elements.namedItem('xrays.takenOn') as HTMLInputElement).value;
    if (!slugInput.value || !slugInput.checkValidity() || !takenOn) {
      xrayStatus.textContent = admin.xrayNeedDate;
      xrayInput.value = '';
      return;
    }
    const slug = slugInput.value;
    let done = 0;
    const failed: string[] = [];
    for (const file of files) {
      if (file.type !== 'application/pdf') {
        failed.push(admin.xrayNotPdf.replace('{name}', file.name));
        continue;
      }
      if (file.size > xrayMaxBytes) {
        failed.push(admin.xrayTooBig.replace('{name}', file.name));
        continue;
      }
      xrayStatus.textContent = admin.photoUploading.replace('{name}', file.name);
      try {
        const { data } = await xrayUpload({ slug, takenOn, bytes: file.size });
        // Before the PUT, so a half-finished upload is still deleted by Save or Cancel.
        uploaded.add(data.key);
        const put = await fetch(data.url, { method: 'PUT', headers: data.headers, body: file });
        if (!put.ok) throw new Error(`R2 answered ${put.status}`);
        // The link check skips off-origin hrefs, so this is the only check a dead download meets.
        const head = await fetch(`${media.base}/${data.key}`, {
          method: 'HEAD',
          cache: 'no-store',
        });
        if (!head.ok) throw new Error(`${media.base} answered ${head.status}`);
        addXray({ key: data.key, bytes: file.size });
        done++;
      } catch {
        failed.push(admin.xrayFailed.replace('{name}', file.name));
      }
    }
    xrayStatus.textContent = [
      done ? admin.xrayDone.replace('{count}', String(done)) : '',
      ...failed,
    ]
      .filter(Boolean)
      .join(' ');
    // The tick covered the files just checked, not the next ones.
    xrayInput.value = '';
    xrayConfirm.checked = false;
    xrayInput.disabled = true;
  }

  xrayConfirm.addEventListener('change', () => (xrayInput.disabled = !xrayConfirm.checked));
  xrayInput.addEventListener('change', () => uploadXrays(xrayInput.files));

  function open(slug: string | null) {
    editing = slug;
    editor.reset();
    errors.replaceChildren();
    photoStatus.textContent = '';
    photoList.replaceChildren();
    for (const photo of (slug && horses[slug].photos) || []) addPhoto(photo);
    coverStatus.textContent = '';
    showCover((slug && horses[slug].phoneCover) || '');
    uploaded = new Set();
    xrayStatus.textContent = '';
    xrayInput.disabled = true;
    xrayList.replaceChildren();
    for (const file of storedXrays()) addXray(file);
    // A build still running keeps its line: its link names the horse it was started for.
    if (!previewButton.disabled) previewStatus.textContent = '';
    slugInput.value = slug ?? '';
    slugInput.readOnly = slug !== null;
    editorTitle.textContent = slug ? (horses[slug].name ?? slug) : admin.newHorse;
    if (slug) {
      const fields = toFields(horses[slug]);
      for (const el of controls()) if (el.name in fields) el.value = String(fields[el.name]);
    }
    listView.hidden = true;
    editor.hidden = false;
    editorTitle.focus();
  }

  function close() {
    editing = null;
    editor.hidden = true;
    listView.hidden = false;
    $('list-title').focus();
  }

  function fail(lines: string[]) {
    errors.replaceChildren(
      ...lines.map((line) => Object.assign(document.createElement('li'), { textContent: line })),
    );
  }

  /*
   * Checks and writes the form. Returns the slug as saved, or nothing with the reasons
   * on screen. The editor stays open on that horse, so a new one becomes an existing one.
   */
  async function saveHorse(): Promise<string | undefined> {
    errors.replaceChildren();
    if (!editor.reportValidity()) return;
    const slug = slugInput.value;
    if (editing === null && Object.hasOwn(horses, slug)) {
      fail([admin.slugTaken]);
      return;
    }

    const fields = Object.fromEntries(
      controls().map((el) => [
        el.name,
        el instanceof HTMLInputElement && el.type === 'number'
          ? el.value === ''
            ? undefined
            : el.valueAsNumber
          : el.value,
      ]),
    );
    // An edit keeps its place; a new horse goes to the end of the list.
    const order =
      editing !== null
        ? (horses[editing].order ?? 0)
        : Math.max(-1, ...Object.values(horses).map((h) => h.order ?? 0)) + 1;
    const horse = fromFields(fields);
    // The starts sync owns these two, so a Save keeps what it last wrote.
    const stored = editing !== null ? horses[editing].facts : undefined;
    horse.facts = {
      ...horse.facts,
      lastStart: stored?.lastStart ?? null,
      starts: stored?.starts ?? null,
    };
    const result = horseSchema.safeParse({ ...horse, order });
    if (!result.success) {
      const issues = result.error.issues;
      fail([admin.invalid, ...issues.map((i) => `${i.path.join('.')}: ${i.message}`)]);
      const first = issues
        .map((i) => editor.elements.namedItem(i.path.join('.')))
        .find((el) => el instanceof HTMLElement);
      first?.focus();
      return;
    }
    // A PL text with no EN twin would leave an empty row on the English page.
    const half = halfPairs(result.data);
    if (half.length) {
      fail([admin.pairHalf, ...half]);
      half
        .map((name) => editor.elements.namedItem(name))
        .find((el) => el instanceof HTMLElement)
        ?.focus();
      return;
    }
    // Publish deletes a sold horse's X-ray files for good (E2.8), so say so before it is too late.
    if (
      result.data.status === 'sold' &&
      result.data.xrays?.files.length &&
      !confirm(admin.soldConfirm)
    )
      return;

    const kept = new Set(result.data.xrays?.files.map((file) => file.key));
    const gone = [...new Set([...storedXrays().map((file) => file.key), ...uploaded])].filter(
      (key) => !kept.has(key),
    );

    save.disabled = true;
    try {
      // Before the write: a failed delete leaves the record as it was, and a retry counts a 404 as done.
      if (gone.length) await xrayDelete({ keys: gone });
      // Through JSON: the Realtime Database rejects `undefined` anywhere in a write.
      await set(ref(db, `horses/${slug}`), JSON.parse(JSON.stringify(result.data)));
      editing = slug;
      slugInput.readOnly = true;
      uploaded = new Set();
      editorTitle.textContent = result.data.name;
      return slug;
    } catch {
      fail([admin.saveFailed]);
    } finally {
      save.disabled = false;
    }
  }

  editor.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (await saveHorse()) close();
  });

  /*
   * Publish (E2.6): the Function stamps the date and dispatches `deploy.yml`,
   * then the panel watches that run until it finishes or fails.
   */
  const publishButton = $<HTMLButtonElement>('publish');
  const publishStatus = $('publish-status');
  const publishCall = httpsCallable<void, { at: number }>(functions, 'publish');
  // ponytail: the unauthenticated Actions API — 60 requests an hour per IP, and the repo
  // must stay public. A second callable reading runs with the PAT is the upgrade.
  const repo = 'https://api.github.com/repos/NF-Revolution/hanna-vavilava-site';

  /* Resolves true when the first `workflow` run created after `since` succeeds. Gives up after 15 minutes. */
  async function deployed(workflow: string, since: number) {
    const runs = `${repo}/actions/workflows/${workflow}/runs?event=repository_dispatch&per_page=1`;
    for (let i = 0; i < 60; i++) {
      await new Promise((resolve) => setTimeout(resolve, 15_000));
      const run = await fetch(runs, { cache: 'no-store' })
        .then((r) => r.json())
        .then((body) => body.workflow_runs?.[0])
        .catch(() => undefined);
      // A few seconds of slack for the gap between Google's clock and GitHub's.
      if (!run || Date.parse(run.created_at) < since - 5_000) continue;
      if (run.status === 'completed') return run.conclusion === 'success';
    }
    return false;
  }

  publishButton.addEventListener('click', async () => {
    publishButton.disabled = true;
    publishStatus.textContent = admin.publishSending;
    try {
      const { data } = await publishCall();
      publishStatus.textContent = admin.publishBuilding;
      publishStatus.textContent = (await deployed('deploy.yml', data.at))
        ? admin.publishDone
        : admin.publishFailed;
    } catch {
      publishStatus.textContent = admin.publishFailed;
    } finally {
      publishButton.disabled = false;
    }
  });

  /*
   * Preview (E2.15, E2.16): the editor saves first, because the build reads the database,
   * then the Function dispatches `draft.yml`, which builds what is saved to the `draft`
   * channel. The channel's URL ends in a hash Firebase picks, so the panel reads it from
   * the `draft` environment's newest deployment status.
   */
  const previewButton = $<HTMLButtonElement>('preview');
  const previewStatus = $('preview-status');
  const previewCall = httpsCallable<void, { at: number }>(functions, 'preview');

  async function draftUrl(): Promise<string | undefined> {
    const json = (url: string) => fetch(url, { cache: 'no-store' }).then((r) => r.json());
    const [deployment] = await json(`${repo}/deployments?environment=draft&per_page=1`);
    const [status] = await json(deployment.statuses_url);
    return status?.environment_url || undefined;
  }

  const newTab = (href: string, text: string) =>
    Object.assign(document.createElement('a'), {
      href,
      target: '_blank',
      rel: 'noopener',
      textContent: text,
    });

  previewButton.addEventListener('click', async () => {
    previewButton.disabled = true;
    previewStatus.textContent = '';
    try {
      // The slug as saved, so a link never names a page the build does not have.
      const slug = await saveHorse();
      if (!slug) return;
      const name = horses[slug]?.name ?? slug;
      previewStatus.textContent = admin.publishSending;
      const { data } = await previewCall();
      previewStatus.textContent = admin.previewBuilding;
      const base = (await deployed('draft.yml', data.at)) && (await draftUrl());
      if (!base) throw new Error('no preview URL');
      previewStatus.replaceChildren(
        newTab(
          new URL(path('pl', 'horse', slug), base).href,
          admin.previewHorse.replace('{name}', name),
        ),
        ' · ',
        newTab(new URL(path('pl', 'horses'), base).href, admin.previewList),
        ` ${admin.previewReady}`,
      );
    } catch {
      previewStatus.textContent = admin.previewFailed;
    } finally {
      previewButton.disabled = false;
    }
  });

  /*
   * Refresh starts (E2.12): the Function writes the facts that changed and names
   * them here, with any horse livejumping failed on. Publish takes them live.
   */
  const refreshButton = $<HTMLButtonElement>('refresh-starts');
  const refreshStatus = $('refresh-status');
  type Change = { name: string; field: 'starts' | 'lastStart'; from: string; to: string };
  const refreshCall = httpsCallable<
    void,
    { changes: Change[]; errors: { name: string; message: string }[] }
  >(functions, 'refreshStarts');
  const lines = (texts: string[]) =>
    refreshStatus.replaceChildren(
      ...texts.map((text) => Object.assign(document.createElement('li'), { textContent: text })),
    );

  refreshButton.addEventListener('click', async () => {
    refreshButton.disabled = true;
    lines([admin.refreshSending]);
    try {
      const { data } = await refreshCall();
      lines([
        ...(data.changes.length ? [] : [admin.refreshNone]),
        ...data.changes.map((c) =>
          admin.refreshChange
            .replace('{name}', c.name)
            .replace('{field}', admin.fields[`facts.${c.field}`])
            .replace('{from}', c.from || '—')
            .replace('{to}', c.to || admin.refreshCleared),
        ),
        ...data.errors.map((e) =>
          admin.refreshError.replace('{name}', e.name).replace('{message}', e.message),
        ),
      ]);
    } catch (e) {
      // `unavailable` is the Function naming livejumping; anything else never reached it.
      const { code, message } = e as { code?: string; message: string };
      lines([
        code === 'functions/unavailable'
          ? admin.refreshFailed.replace('{message}', message)
          : admin.refreshBroken.replace('{message}', code ?? message),
      ]);
    } finally {
      refreshButton.disabled = false;
    }
  });

  /*
   * The enquiry count (E2.14): how many are still unhandled, live, so one that
   * lands while the panel is open shows up at once. The list is /admin/zapytania.
   */
  const enquiryCount = $('enquiry-count');
  const enquiryError = $('enquiry-error');

  function countEnquiries(enquiries: Record<string, Stored>) {
    const waiting = Object.values(enquiries).filter((e) => !isHandled(e)).length;
    enquiryCount.textContent = waiting
      ? plural('pl', admin.enquiriesWaiting, waiting)
      : admin.enquiriesNone;
  }

  $('add').addEventListener('click', () => open(null));
  $('cancel').addEventListener('click', () => {
    // Uploaded and never saved: nothing links to it, so it goes now.
    // ponytail: a failure here leaves an unlinked object nobody can reach from the panel.
    const stored = new Set(storedXrays().map((file) => file.key));
    const orphans = [...uploaded].filter((key) => !stored.has(key));
    if (orphans.length) xrayDelete({ keys: orphans }).catch(() => {});
    close();
  });

  onAuthStateChanged(auth, async (user) => {
    unsubscribe?.();
    unsubscribe = undefined;
    if (!user) return show(form);
    // Forced refresh: a claim granted after sign-in shows up on the next load.
    const { claims } = await user.getIdTokenResult(true);
    if (claims.admin !== true) return show(noAccess);
    who.textContent = admin.signedInAs.replace('{email}', user.email ?? '');
    // ponytail: the whole `/enquiries` tree, fine to a few thousand records.
    // orderByChild('createdAt') + limitToLast, with an `.indexOn` rule, is the upgrade.
    const off = [
      onValue(
        ref(db, 'horses'),
        (snapshot) => {
          horses = snapshot.val() ?? {};
          render();
        },
        () => (listError.textContent = admin.saveFailed),
      ),
      onValue(
        ref(db, 'enquiries'),
        (snapshot) => countEnquiries(snapshot.val() ?? {}),
        () => (enquiryError.textContent = admin.saveFailed),
      ),
    ];
    unsubscribe = () => off.forEach((f) => f());
    editor.hidden = true;
    listView.hidden = false;
    show(shell);
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const button = form.querySelector('button')!;
    button.disabled = true;
    error.textContent = '';
    try {
      await signInWithEmailAndPassword(
        auth,
        String(data.get('email')),
        String(data.get('password')),
      );
      form.reset();
    } catch (e) {
      const code = (e as AuthError).code;
      error.textContent =
        code === 'auth/invalid-credential'
          ? admin.errors.credentials
          : code === 'auth/too-many-requests'
            ? admin.errors.throttled
            : admin.errors.generic;
    } finally {
      button.disabled = false;
    }
  });

  for (const button of document.querySelectorAll('[data-sign-out]')) {
    button.addEventListener('click', () => signOut(auth));
  }
</script>

