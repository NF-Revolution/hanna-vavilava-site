---
import Page from '../layouts/Page.astro';
import SubBar from '../components/SubBar.astro';
import { t } from '../i18n';

const locale = 'pl' as const;
const dict = t(locale);
const page = dict.pages.about;
---

<Page locale={locale} routeKey="about" title={page.title} description={page.description}>
  <SubBar label={page.label} />
  <section class="stub">
    <!-- Ticket 4.6 — portrait, bio, the five buying steps. -->
    <p class="copy">4.6 — portrait, bio, the five buying steps</p>
  </section>
</Page>

<style>
  .stub {
    padding: 80px var(--gutter);
    color: var(--ink-muted);
  }
</style>
