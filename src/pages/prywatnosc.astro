---
import Page from '../layouts/Page.astro';
import SubBar from '../components/SubBar.astro';
import { turnstilePrivacyHref } from '../site';
import { t } from '../i18n';

const locale = 'pl' as const;
const dict = t(locale);
const page = dict.pages.privacy;
---

<Page locale={locale} routeKey="privacy" title={page.title} description={page.description}>
  <SubBar label={page.label} />
  <section class="stub">
    <!-- Ticket 7.3 — RODO Art. 13 notice. -->
    <p class="copy">7.3 — RODO Art. 13 notice</p>
    <!-- Interim, until 7.3 (#59): invisible Turnstile requires this link (E5.6). -->
    <p class="copy turnstile">
      {page.turnstile} <a href={turnstilePrivacyHref}>{page.turnstileLink}</a>
    </p>
  </section>
</Page>

<style>
  .turnstile {
    max-width: 680px;
    color: var(--ink);
  }

  .turnstile a {
    text-decoration: underline;
  }

  .stub {
    padding: 80px var(--gutter);
    color: var(--ink-muted);
  }
</style>
