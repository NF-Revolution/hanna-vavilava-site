---
/* Every page behind the menu: light ground, header band, footer, drawer. */
import Base, { type Props as BaseProps } from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import MobileBar from '../components/MobileBar.astro';
import type { Locale } from '../i18n';
import type { RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  title: string;
  description: string;
  headerLinks?: RouteKey[];
  /* `overlay` floats the header on a dark hero, as the horse detail boards draw it. */
  header?: 'page' | 'overlay';
  noindex?: boolean;
  /* The WhatsApp href of the 390 bottom bar; without it the page has no bar. */
  bar?: string;
  image?: BaseProps['image'];
  /* Where the bar's "Formularz" goes; the enquiry page unless the page has its own form. */
  barForm?: string;
}

const {
  locale,
  routeKey,
  slug,
  title,
  description,
  headerLinks,
  header = 'page',
  noindex,
  bar,
  image,
  barForm,
} = Astro.props;
---

<Base
  locale={locale}
  routeKey={routeKey}
  slug={slug}
  title={title}
  description={description}
  ground="light"
  noindex={noindex}
  image={image}
>
  <Header locale={locale} variant={header} status={false} links={headerLinks} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer locale={locale} routeKey={routeKey} slug={slug} />
  {bar && <MobileBar locale={locale} whatsapp={bar} form={barForm} />}
  <MenuDrawer locale={locale} routeKey={routeKey} slug={slug} />
</Base>
