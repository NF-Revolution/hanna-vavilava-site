---
/* Every page behind the menu: light ground, header band, footer, drawer. */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import type { Locale } from '../i18n';
import type { RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  title: string;
  description: string;
  headerLinks?: RouteKey[];
}

const { locale, routeKey, slug, title, description, headerLinks } = Astro.props;
---

<Base
  locale={locale}
  routeKey={routeKey}
  slug={slug}
  title={title}
  description={description}
  ground="light"
>
  <Header locale={locale} variant="page" links={headerLinks} />
  <main id="main">
    <slot />
  </main>
  <Footer locale={locale} routeKey={routeKey} slug={slug} />
  <MenuDrawer locale={locale} routeKey={routeKey} slug={slug} />
</Base>
