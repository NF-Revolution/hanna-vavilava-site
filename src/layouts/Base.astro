---
import '../styles/fonts.css';
import '../styles/base.css';
import { locales, htmlLang, t, type Locale } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { analytics, indexable, umami } from '../site';

export interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  title: string;
  description: string;
  /* Dark is the video screens; light is every page behind the menu. */
  ground?: 'light' | 'dark';
  /* A 404 has no canonical URL and no twin, so it drops both and asks not to be indexed.
     A build that is not `indexable` asks the same of every page but keeps the head. */
  noindex?: boolean;
  /* The link preview card (E6.2): an absolute URL to a JPEG, 1200 × 630 unless the photo is smaller. */
  image?: { src: string; width: number; height: number; alt: string };
}

const {
  locale,
  routeKey,
  slug,
  title,
  description,
  ground = 'light',
  noindex,
  image,
} = Astro.props;
const dict = t(locale);

const canonical = new URL(path(locale, routeKey, slug), Astro.site);
const alternates = locales.map((l) => ({
  locale: l,
  href: new URL(path(l, routeKey, slug), Astro.site).href,
}));
const ogLocale: Record<Locale, string> = { pl: 'pl_PL', en: 'en_GB' };

/*
 * The analytics beacon (E6.6): a pageview on load, and an event for any link or
 * form carrying `data-event`, any `wa.me` / `t.me` link, and the first play of a
 * `<video data-event>`. The element's other `data-*` attributes become the event's
 * data, and on a horse page every event carries `horse`. The sent and not-sent
 * pages report `enquiry_success` and `enquiry_failure`. Homepage bounce is Umami's
 * bounce rate on the `/` and `/en` entry pages: each entry point is a navigation or
 * an event. The URL drops the hash, which holds the buyer's number on the sent page.
 * ponytail: ad-blockers drop `*.umami.is`; a `/api/event` rewrite to a Function that
 * forwards with X-Forwarded-For if the counts look low.
 *
 * Hand-minified, as the sent page's echo is (E5.7): the formatter would triple its
 * size, and it is the one script on every page. Wrapped, so its names never meet
 * another inline script's.
 */
const J = JSON.stringify;
const pageEvent = (
  { enquirySent: 'enquiry_success', enquiryFailed: 'enquiry_failure' } as Partial<
    Record<RouteKey, string>
  >
)[routeKey];
const beacon =
  analytics &&
  String.raw`(()=>{const w=${J(umami.website)},h=${J(routeKey === 'horse' ? slug : null)},s=(n,d)=>fetch(${J(umami.endpoint)},{method:"POST",keepalive:!0,headers:{"Content-Type":"application/json","x-umami-website-id":w},body:JSON.stringify({type:"event",payload:{website:w,hostname:location.hostname,url:location.pathname+location.search,referrer:document.referrer,language:navigator.language,screen:screen.width+"x"+screen.height,name:n,data:n&&{...h&&{horse:h},...d}}})}).catch(()=>{}),f=(e,n)=>{const{event:v,...d}=e.dataset;(v||n)&&s(v||n,d)},o=(t,l)=>addEventListener(t,l,!0);s();h&&s("horse_view");${pageEvent ? `s(${J(pageEvent)});` : ''}o("click",e=>{const a=e.target.closest?.("a");a&&f(a,{"wa.me":"whatsapp_click","t.me":"telegram_click"}[a.host])});o("submit",e=>f(e.target));o("play",e=>{const v=e.target;v.dataset?.event&&(f(v),delete v.dataset.event)})})()`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || !indexable) && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical.href} />
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={htmlLang[alt.locale]} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
        {locales
          .filter((l) => l !== locale)
          .map((l) => (
            <meta property="og:locale:alternate" content={ogLocale[l]} />
          ))}
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    {image && (
      <>
        <meta property="og:image" content={image.src} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={ground === 'dark' ? '#0E0E0D' : '#F6F5F2'} />

    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    {locale === 'pl' && (
      <link
        rel="preload"
        href="/fonts/archivo-latin-ext.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <slot name="head" />
    {beacon && <script is:inline set:html={beacon}></script>}
  </head>
  <body data-ground={ground}>
    <a class="skip-link" href="#main">
      {dict.a11y.skipToContent}
    </a>
    <slot />
  </body>
</html>
