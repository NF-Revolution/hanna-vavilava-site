---
/*
 * The same three elements everywhere: hamburger, wordmark, a short right-hand
 * nav. Over the video it floats on the dark ground and carries the status
 * line; on a page it is an 88px band and the status line moves to the sub-bar.
 */
import WhatsApp from './icons/WhatsApp.astro';
import { t, type Locale } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { plural, fill, formatDate } from '../i18n/format';
import { site, whatsappHref } from '../site';

interface Props {
  locale: Locale;
  variant?: 'page' | 'overlay';
  links?: RouteKey[];
}

const { locale, variant = 'page', links = ['horses', 'enquiry'] } = Astro.props;
const dict = t(locale);

const status = [
  dict.status.city,
  plural(locale, dict.status.horsesAvailable, site.horsesAvailable),
  fill(dict.status.updated, { date: formatDate(locale, site.updated) }),
];
---

<header class:list={['head', variant]}>
  <a class="menu-trigger" href={path(locale, 'menu')} aria-label={dict.a11y.openMenu}>
    <span></span>
    <span></span>
  </a>

  <div class="wordmark">
    <a class="wordmark-link" href={path(locale, 'home')}>
      <span class="wordmark-name">{dict.brand.name}</span>
      <span class="lbl wordmark-tagline">{dict.brand.tagline}</span>
    </a>
    {variant === 'overlay' && <p class="meta status">{status.join('  |  ')}</p>}
  </div>

  <nav class="head-nav" aria-label={dict.a11y.navPrimary}>
    {links.map((key) => (
      <a class="lbl" href={path(locale, key)}>
        {dict.nav[key as 'horses']}
      </a>
    ))}
    <a href={whatsappHref()} aria-label={dict.a11y.whatsapp} class="head-wa">
      <WhatsApp />
    </a>
  </nav>
</header>

<style>
  .head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    padding-inline: var(--gutter);
    box-sizing: border-box;
  }

  .page {
    height: var(--header-h);
    align-items: center;
    border-bottom: 1px solid var(--rule);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    align-items: start;
    padding-top: 34px;
    color: var(--ink-inv);
  }

  /*
   * The scrim. This band sits on the video, and the wordmark tagline and the
   * status line are --ink-inv-muted, which needs --scrim-strong to clear
   * 4.5:1 against a white frame. The gradient is solid for the full height of
   * the text and only fades below it — a gradient behind the text itself
   * would put the last line on less alpha than the floor.
   */
  .overlay::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 190px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      var(--scrim-strong) 0%,
      var(--scrim-strong) 60%,
      transparent 100%
    );
  }

  /* 26px of bars inside a 44px box, which is what the board draws. */
  .menu-trigger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: var(--tap);
    min-height: var(--tap);
  }

  .menu-trigger span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .wordmark-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: var(--tap);
  }

  .wordmark-name {
    font-size: 15px;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    padding-left: 0.44em;
    white-space: nowrap;
  }

  .wordmark-tagline {
    font-size: 8px;
    letter-spacing: 0.3em;
    color: var(--ink-muted);
  }

  .overlay .wordmark-tagline {
    font-size: 9px;
    color: var(--ink-inv-muted);
  }

  .status {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--ink-inv-muted);
    text-align: center;
  }

  .head-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 26px;
  }

  .head-nav .lbl {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .overlay .head-nav {
    padding-top: 4px;
  }

  .head-wa {
    display: flex;
    min-height: var(--tap);
    align-items: center;
  }

  @media (max-width: 720px) {
    .head {
      padding-inline: var(--gutter-mobile);
    }
    .status,
    .head-nav .lbl {
      display: none;
    }
    .overlay .status {
      display: block;
      font-size: 9px;
      letter-spacing: 0.14em;
    }
  }
</style>
