---
/*
 * The nine-field enquiry (E5.1): a plain POST with native validation and no
 * JavaScript. Select values are language-neutral codes — a horse slug or
 * `undecided` for the horse — so the endpoint and the inbox never depend on
 * the language the buyer used. The option text lives in the dictionaries,
 * keyed by those codes.
 *
 * `whatsapp` must start with + and a country code: a local number next to a
 * country field is a buyer Hanna cannot call back. `instagram` takes no pattern,
 * so a pasted profile link is not refused; the endpoint (#42) normalises it.
 *
 * `/api/enquiry` is rewritten to `submitEnquiry` (E5.3). `locale` picks the sent
 * page; `website` is the honeypot, off-screen and out of the tab order; `elapsed`
 * is the time trap, filled on submit by the one inline script, and simply absent
 * without JavaScript. The same script sends `page` and `ref`, the page and the one
 * before it, which the Telegram message (#43) shows with the campaign read from them.
 *
 * The `cf-turnstile` div is the invisible Turnstile (E5.6). The same script
 * appends Cloudflare's the first time a visitor focuses a field of a form that
 * holds the widget, never the gallery's or the menu's dialog form. So browsing
 * loads nothing third-party, and the enquiry page's search form is covered too.
 * Cloudflare's script renders the widget and adds the
 * `cf-turnstile-response` field the endpoint verifies. Without JavaScript there
 * is no token and the endpoint writes nothing, so the `<noscript>` line sends
 * the buyer to WhatsApp instead.
 *
 * `horse` preselects that horse, as the horse page does (E5.2); `dark` is that
 * page's inverted band, four columns wide where there is room. The parent
 * carries `.dk`, which sets the dark placeholder and hover colours. Beside the
 * send button, `ContactLinks` offers the other ways to write, prefilled with
 * that horse (E5.8).
 */
import { t, type Locale } from '../i18n';
import { formatPrice } from '../i18n/format';
import { path } from '../i18n/routes';
import { site, turnstileSitekey } from '../site';
import ContactLinks from './ContactLinks.astro';

interface Props {
  locale: Locale;
  horse?: string;
  dark?: boolean;
}
const { locale, horse, dark } = Astro.props;
const f = t(locale).enquiryForm;
const chosen = site.horsesListed.find((h) => h.slug === horse);
const prefill = chosen && {
  name: chosen.name,
  url: new URL(path(locale, 'horse', chosen.slug), Astro.site).href,
};

const horses = [
  ...site.horsesListed.map((h) => ({
    value: h.slug,
    text: h.price === null ? h.name : `${h.name} — ${formatPrice(locale, h.price)}`,
  })),
  { value: 'undecided', text: f.undecided },
];

const selects = [
  { name: 'level', label: f.level, options: Object.entries(f.levels) },
  { name: 'budget', label: f.budget, options: Object.entries(f.budgets), num: true },
  { name: 'timeframe', label: f.timeframe, options: Object.entries(f.timeframes) },
  {
    name: 'horse',
    label: horse ? f.horseSelected : f.horse,
    options: horses.map((h) => [h.value, h.text]),
  },
];
---

<form class:list={['enquiry', dark && 'dark']} method="post" action="/api/enquiry">
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="elapsed" />
  <input type="hidden" name="page" />
  <input type="hidden" name="ref" />
  <label class="trap" aria-hidden="true">
    {f.trap}
    <input name="website" type="text" tabindex="-1" autocomplete="off" />
  </label>
  <div class="fields">
    <label class="fld">
      <span class="lbl">{f.name}</span>
      <input class="und" name="name" type="text" required maxlength="100" autocomplete="name" />
    </label>
    <label class="fld">
      <span class="lbl">{f.country}</span>
      <input
        class="und"
        name="country"
        type="text"
        required
        maxlength="60"
        autocomplete="country-name"
      />
    </label>
    <label class="fld">
      <span class="lbl">{f.whatsapp}</span>
      <input
        class="und num"
        name="whatsapp"
        type="tel"
        required
        maxlength="30"
        pattern="\+\d[\d\s\-]{5,}\d"
        title={f.whatsappFormat}
        placeholder={f.whatsappPlaceholder}
        autocomplete="tel"
      />
    </label>
    <label class="fld">
      <span class="lbl">{f.instagram}</span>
      <input
        class="und"
        name="instagram"
        type="text"
        maxlength="100"
        placeholder={f.instagramPlaceholder}
        autocomplete="off"
      />
    </label>
    {selects.map((s) => (
      <label class="fld">
        <span class="lbl">{s.label}</span>
        <span class="pick">
          <select class:list={['und', s.num && 'num']} name={s.name} required>
            {/* A blank first option, so `required` forces a real choice. */}
            <option value="" />
            {s.options.map(([value, text]) => (
              <option value={value} selected={value === horse}>
                {text}
              </option>
            ))}
          </select>
          <svg width="11" height="7" viewBox="0 0 11 7" aria-hidden="true">
            <path d="M1 1l4.5 4.5L10 1" />
          </svg>
        </span>
      </label>
    ))}
    <!-- Nine fields: the message takes the last row whole. -->
    <label class="fld wide">
      <span class="lbl">{f.note}</span>
      <input class="und" name="note" type="text" maxlength="2000" />
    </label>
  </div>

  <div class="cf-turnstile" data-sitekey={turnstileSitekey}></div>
  <noscript>
    <p class="lbl nojs">{f.noscript}</p>
  </noscript>

  <div class="actions">
    <button class="lbl send" type="submit">
      {f.submit}
    </button>
    <ContactLinks locale={locale} prefill={prefill} />
  </div>
</form>

<script is:inline>
  // Delegated: the search form (#126) sits below this script, not yet parsed when it runs.
  document.addEventListener('submit', ({ target: form }) => {
    if (!form.elapsed) return;
    form.elapsed.value = Math.round(performance.now());
    form.page.value = location.href;
    form.ref.value = document.referrer;
  });
  document.addEventListener('focusin', function load(e) {
    if (!e.target.form?.querySelector('.cf-turnstile')) return;
    document.removeEventListener('focusin', load);
    const src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    document.head.append(Object.assign(document.createElement('script'), { src }));
  });
</script>

<style>
  .trap {
    position: absolute;
    left: -9999px;
  }

  /* Out of flow, so the empty widget adds no gap; the invisible mode draws nothing. */
  .cf-turnstile {
    position: absolute;
  }

  .nojs {
    margin: 0;
    color: var(--ink-muted);
  }

  .dark .nojs {
    color: var(--ink-inv-muted);
  }

  .enquiry {
    display: flex;
    flex-direction: column;
    gap: 42px;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 42px 60px;
  }

  .fld {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .fld > .lbl {
    color: var(--ink-muted);
  }

  .und {
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid var(--rule-field);
    padding: 9px 0 11px;
    font-size: 15px;
  }

  .pick {
    position: relative;
  }

  .pick select {
    padding-right: 24px;
    cursor: pointer;
  }

  .pick svg {
    position: absolute;
    right: 0;
    top: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    pointer-events: none;
  }

  /* Top-aligned: the WhatsApp link sits level with the button, the quiet row under it. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px;
  }

  .send {
    min-height: var(--tap);
    padding: 19px 44px;
    box-sizing: border-box;
    background: var(--ink);
    color: var(--ink-inv);
    text-align: center;
  }

  /* ---- The horse page's inverted band ---- */

  .dark .fld > .lbl {
    color: var(--ink-inv-muted);
  }

  .dark .und {
    border-color: var(--rule-field-inv);
  }

  /* The open list is the browser's own, on a light ground. */
  .dark option {
    color: var(--ink);
  }

  .dark .send {
    background: var(--ink-inv);
    color: var(--ground-dark);
  }

  @media (min-width: 1101px) {
    .dark .fields {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 40px 50px;
    }
  }

  @media (max-width: 720px) {
    .fields {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
  }
</style>
