---
/*
 * Where `submitEnquiry`'s 303 lands (E5.7): the sent page as the Confirmation
 * board draws it, or with `failed` the not-sent page, which only the Function's
 * refusals reach. Success is never shown for a send that did not happen.
 *
 * The sent page's fragment is the number the Function stored (`#+48600123456`).
 * The inline script shows it only if it is a bare `+` and digits, and only as
 * text, so a typo can be caught and corrected over WhatsApp. No hash, as after
 * a trapped post, and the line stays hidden. Both pages are `noindex`.
 */
import Page from '../layouts/Page.astro';
import SubBar from './SubBar.astro';
import WhatsApp from './icons/WhatsApp.astro';
import { t, type Locale } from '../i18n';
import { fill } from '../i18n/format';
import { path } from '../i18n/routes';
import { site, stables, whatsappHref, directionsHref } from '../site';

interface Props {
  locale: Locale;
  failed?: boolean;
}
const { locale, failed } = Astro.props;
const pages = t(locale).pages;
const sent = pages.enquirySent;
const page = failed ? pages.enquiryFailed : sent;
const hours = { hours: site.responseWindow };
const [echoBefore, echoAfter] = sent.echo.split('{number}');
const echo = String.raw`const n=decodeURIComponent(location.hash.slice(1));if(/^\+\d+$/.test(n)){const e=document.getElementById('echo');e.querySelector('strong').textContent=n;e.hidden=false}`;
---

<Page
  locale={locale}
  routeKey={failed ? 'enquiryFailed' : 'enquirySent'}
  title={page.title}
  description={page.description}
  noindex
>
  <SubBar label={page.label}>
    <p class="meta sub-meta">{fill(pages.enquiry.meta, hours)}</p>
  </SubBar>

  <section class="done">
    <h2 class="heading">{page.heading}</h2>
    <p class="copy body">{fill(page.body, hours)}</p>
    {!failed && (
      <>
        <p class="copy echo" id="echo" hidden>
          {echoBefore}
          <strong class="num" />
          {echoAfter}
        </p>
        <script is:inline set:html={echo}></script>
        <ol class="steps">
          {sent.steps.map((step, i) => (
            <li class="step">
              <span class="lbl step-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="lbl">{step.title}</span>
              <p class="copy step-text">
                {fill(step.text, { phone: site.phone, stables: stables.name })}
              </p>
              {/* ponytail: the meeting step is index 1; a `link` field on the step if another needs one. */}
              {i === 1 && (
                <a class="lbl more step-link" href={directionsHref}>
                  {sent.directions}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))}
        </ol>
      </>
    )}
    <div class="actions">
      <a class="lbl btn" href={whatsappHref()}>
        <WhatsApp size={16} />
        {sent.whatsapp}
      </a>
      <a class="lbl more" href={failed ? path(locale, 'enquiry') : path(locale, 'horses')}>
        {failed ? pages.enquiryFailed.retry : sent.back}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Page>

<style>
  .sub-meta {
    margin: 0;
    color: var(--ink-muted);
  }

  .done {
    max-width: 1040px;
    padding: 96px var(--gutter) 104px;
  }

  .heading {
    margin: 0 0 22px;
    font-size: 44px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  .body,
  .echo {
    max-width: 620px;
    margin: 0 0 16px;
    color: var(--ink-muted);
  }

  .echo {
    color: var(--ink);
  }

  .echo strong {
    font-weight: 500;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 44px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .step-num,
  .step-text {
    color: var(--ink-muted);
  }

  .step-text {
    margin: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 52px;
  }

  /* ponytail: the board's two links, scoped here like CtaBand's. A shared stylesheet once a third page needs them. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: var(--tap);
    padding: 19px 38px;
    box-sizing: border-box;
    background: var(--ink);
    color: var(--ground-light);
  }

  .done a.btn:hover {
    color: var(--ink-inv-muted);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    padding-bottom: 8px;
    box-sizing: border-box;
    border-bottom: 1px solid var(--ink);
  }

  .step-link {
    align-self: flex-start;
  }

  @media (max-width: 720px) {
    .done {
      padding: 44px var(--gutter-mobile) 52px;
    }

    .heading {
      margin-bottom: 24px;
      font-size: 28px;
      line-height: 1.15;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 24px;
    }

    .step {
      gap: 10px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      margin-top: 40px;
    }

    .btn {
      min-height: 52px;
      padding: 0 20px;
    }

    .more {
      align-self: flex-start;
    }
  }
</style>
