---
/*
 * The homepage: one full-viewport video with chrome over it and no page
 * underneath. Nothing scrolls. Three ways in — the hamburger, the video
 * itself, and the horse line on the bottom edge.
 *
 * The loop (E3.3) fetches nothing until a script has asked: no `src`, no
 * `autoplay`, `preload="none"`. The poster is an <img> under an invisible
 * <video>, not `poster=`, because iOS Low Power Mode refuses even muted autoplay
 * and draws a play glyph over a video that shows its poster. Reduced motion,
 * Save-Data, a sub-4g connection and no JavaScript all get the same still.
 *
 * ponytail: one landscape rendition, cropped by `object-fit` on a portrait
 * phone where the board draws 9:16. A second encode behind
 * <source media="(orientation: portrait)"> if the crop loses the horse.
 */
import { Picture, inferRemoteSize } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MenuDrawer from './MenuDrawer.astro';
import { t, type Locale } from '../i18n';
import { path } from '../i18n/routes';
import { formatPrice, plural } from '../i18n/format';
import { site } from '../site';
import { hero, media } from '../media';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const page = dict.pages.home;
const horse = site.featuredHorse;

const enterLabel = plural(locale, dict.home.enter, site.horsesAvailable);
// ponytail: a `null` price ("on request", #2) drops the segment until E4.x draws its label.
const horseFacts =
  horse &&
  [
    horse.born,
    `${horse.heightCm} cm`,
    `${horse.levelCm} cm`,
    horse.price === null ? null : formatPrice(locale, horse.price),
  ]
    .filter((part) => part !== null)
    .join(' · ');

const posterSrc = hero && `${media.base}/${hero.posterKey}`;
const poster = posterSrc && (await inferRemoteSize(posterSrc));
---

<Base
  locale={locale}
  routeKey="home"
  title={page.title}
  description={page.description}
  ground="dark"
>
  <!--
    The page is a video, so the text a crawler and a screen reader need is in
    the chrome, not in a hidden block bolted on beside it.
  -->
  <Header locale={locale} variant="overlay" links={['horses']} />

  <main id="main" tabindex="-1" class="screen">
    <h1 class="visually-hidden">{page.h1}</h1>

    <!--
      Named explicitly: without this the link takes its accessible name from
      everything inside the figure, including the ALT: placeholder caption.
    -->
    <a
      class="frame"
      href={path(locale, 'horses')}
      aria-label={dict.nav.horses}
      data-event="home_frame"
    >
      {hero && posterSrc && poster ? (
        <>
          <Picture
            src={posterSrc}
            width={poster.width}
            height={poster.height}
            widths={[...[640, 960, 1280, 1920].filter((w) => w < poster.width), poster.width]}
            sizes="100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            alt=""
            loading="eager"
            fetchpriority="high"
          />
          <video class="loop" muted loop playsinline preload="none" aria-hidden="true">
            <source data-src={`${media.base}/${hero.webmKey}`} type="video/webm" />
            <source data-src={`${media.base}/${hero.mp4Key}`} type="video/mp4" />
          </video>
        </>
      ) : (
        <figure class="poster">
          <!-- PLACEHOLDER: poster frame and video asset, ticket 3.2. -->
          <div class="poster-spec">
            <span class="lbl">{dict.home.videoSpec}</span>
            <span class="lbl poster-spec-faint">{dict.home.videoSpecDetail}</span>
          </div>
          <figcaption class="lbl poster-alt">{dict.home.videoAlt}</figcaption>
        </figure>
      )}
    </a>

    <a class="enter fade-late" href={path(locale, 'horses')} data-event="home_enter">
      <span class="lbl">{enterLabel}</span>
      <span aria-hidden="true" class="enter-arrow">
        &#8594;
      </span>
    </a>

    <div class="edge">
      <!-- Hidden until the loop plays: there is nothing to unmute before that. -->
      <button type="button" class="sound" disabled>
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.1"
          aria-hidden="true"
        >
          <path d="M4 9.5h3.2L12 5.5v13L7.2 14.5H4Z"></path>
          <path d="M15.8 9.2a4 4 0 0 1 0 5.6"></path>
          <path d="M18.4 6.9a7.4 7.4 0 0 1 0 10.2"></path>
        </svg>
        <span class="lbl sound-on">{dict.home.sound}</span>
        <span class="lbl sound-off">{dict.home.soundOff}</span>
        <span class="lbl sound-hint">{dict.home.soundHint}</span>
      </button>

      {horse && (
        <a
          class="horse fade-late"
          href={path(locale, 'horse', horse.slug)}
          data-event="home_horse_line"
        >
          <span class="meta">{horse.name}</span>
          <span class="meta horse-facts num">{horseFacts}</span>
          <span aria-hidden="true" class="horse-arrow">
            &#8594;
          </span>
        </a>
      )}
    </div>
  </main>

  <MenuDrawer locale={locale} routeKey="home" />
</Base>

<script>
  const video = document.querySelector<HTMLVideoElement>('.loop');
  const sound = document.querySelector<HTMLButtonElement>('.sound')!;
  const net = (navigator as { connection?: { saveData?: boolean; effectiveType?: string } })
    .connection;

  // The gate runs before any `src` exists, so a refusal costs no bytes.
  // Safari and Firefox expose no `connection`, and pass.
  if (
    video &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !net?.saveData &&
    (net?.effectiveType ?? '4g') === '4g'
  ) {
    for (const source of video.querySelectorAll('source')) source.src = source.dataset.src!;
    video.load();
    video.addEventListener(
      'playing',
      () => {
        video.classList.add('is-playing');
        sound.disabled = false;
      },
      { once: true },
    );
    // Rejected in iOS Low Power Mode: the video stays invisible over the poster.
    video.play().catch(() => {});

    sound.addEventListener('click', () => {
      video.muted = !video.muted;
      sound.toggleAttribute('data-on', !video.muted);
    });
  }
</script>

<style>
  .screen {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--ground-dark);
    color: var(--ink-inv);
  }

  .frame {
    position: absolute;
    inset: 0;
    display: block;
  }

  .frame :global(img),
  .loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .loop {
    opacity: 0;
    transition: opacity 0.6s ease-out;
  }

  .loop.is-playing {
    opacity: 1;
  }

  .poster {
    position: absolute;
    inset: 0;
    margin: 0;
    background: var(--placeholder-inv);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .poster-spec {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    border: 1px solid #2e2e2a;
    padding: 26px 34px;
    text-align: center;
    color: var(--ink-inv-muted);
  }

  .poster-spec-faint {
    color: var(--ink-inv-faint);
  }

  .poster-alt {
    position: absolute;
    left: var(--gutter);
    bottom: 96px;
    max-width: 520px;
    letter-spacing: 0.14em;
    color: var(--ink-inv-faint);
  }

  .enter {
    position: absolute;
    bottom: 106px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgba(242, 241, 237, 0.6);
    padding: 15px 30px;
    min-height: var(--tap);
    /* A scrim: text over moving video has no guaranteed contrast. */
    background: var(--scrim);
    backdrop-filter: blur(2px);
  }

  .enter-arrow {
    font-size: 12px;
  }

  .edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid rgba(242, 241, 237, 0.22);
    /* --scrim-strong, not --scrim: this bar carries --ink-inv-muted facts. */
    background: var(--scrim-strong);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 58px;
    padding: 0 var(--gutter);
  }

  .sound {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    color: inherit;
  }

  /* visibility, not display: the horse line keeps its place on the right. */
  .sound[disabled] {
    visibility: hidden;
  }

  .sound[data-on] .sound-on,
  .sound:not([data-on]) .sound-off {
    display: none;
  }

  .sound-hint {
    font-size: 9px;
    /* --ink-inv-faint clears no scrim over video; muted is the floor here. */
    color: var(--ink-inv-muted);
  }

  .horse {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: var(--tap);
  }

  .horse-facts,
  .horse-arrow {
    color: var(--ink-inv-muted);
  }

  .meta {
    letter-spacing: 0.2em;
  }

  @media (max-width: 720px) {
    .poster-alt,
    .sound-hint {
      display: none;
    }

    .edge {
      padding-inline: var(--gutter-mobile);
      gap: 12px;
    }

    .horse-facts {
      display: none;
    }

    .enter {
      bottom: 96px;
    }
  }
</style>
