---
/*
 * The horses index, editorial view (E4.2), drawn as `Horses` and `MobileHorses`.
 * Entries alternate image left and image right, and every fourth has a narrower
 * text column and a wider image — chosen by `:nth-child`, so the rhythm holds for
 * any number of horses. Each photo shows whole at its own ratio: a fixed slot
 * crops a standing horse's head (#32, #33). A sold horse is not listed; its page
 * stays (#23).
 */
import Page from '../layouts/Page.astro';
import SubBar from './SubBar.astro';
import Photo from './Photo.astro';
import ViewSwitch from './ViewSwitch.astro';
import { t, type Locale } from '../i18n';
import { fill, formatDate, formatPrice } from '../i18n/format';
import { path } from '../i18n/routes';
import { site } from '../site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const page = dict.pages.horses;
const pad = (n: number) => String(n).padStart(2, '0');

/* Drawn image widths on the 1440 board, per step of the pattern. */
const imageVw = [61, 61, 61, 70];
---

<Page locale={locale} routeKey="horses" title={page.title} description={page.description}>
  <SubBar label={`${page.label} · ${pad(site.horsesListed.length)}`}>
    <p slot="label" class="lbl as-of">
      <span aria-hidden="true">·</span>
      {fill(page.asOf, { date: formatDate(locale, site.updated) })}
    </p>
    <ViewSwitch locale={locale} current="horses" />
  </SubBar>
  <ol class="entries">
    {site.horsesListed.map((horse, i) => (
      <li class="entry">
        <figure class="fig">
          {horse.photos[0] && (
            <Photo
              photo={horse.photos[0]}
              locale={locale}
              sizes={`(max-width: 720px) 100vw, ${imageVw[i % 4]}vw`}
              hero={i === 0}
            />
          )}
        </figure>
        <div class="text">
          <p class="meta num nr">{pad(i + 1)}</p>
          <h2 class="name">{horse.name}</h2>
          <p class="meta num facts">
            {[
              horse.born,
              `${horse.heightCm} cm`,
              page.sex[horse.sex],
              horse.breed,
              `${horse.levelCm} cm`,
            ].join(' · ')}
          </p>
          <p class="num price">
            {horse.price === null ? page.onRequest : formatPrice(locale, horse.price)}
          </p>
          <p class="copy blurb">{horse.headline[locale]}</p>
          <a class="more" href={path(locale, 'horse', horse.slug)}>
            <span class="lbl">{page.more}</span>
            <span class="visually-hidden">: {horse.name}</span>
            <span aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </li>
    ))}
  </ol>
</Page>

<style>
  .as-of {
    margin: 0;
    display: flex;
    gap: 20px;
    color: var(--ink-muted);
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    display: grid;
    align-items: center;
    grid-template-columns: 880fr 560fr;
    grid-template-areas: 'fig text';
  }

  .entry + .entry {
    border-top: 1px solid var(--rule-hair);
  }

  .entry:nth-child(even) {
    grid-template-columns: 560fr 880fr;
    grid-template-areas: 'text fig';
  }

  .entry:nth-child(4n) {
    grid-template-columns: 440fr 1000fr;
    grid-template-areas: 'text fig';
  }

  .fig {
    grid-area: fig;
    margin: 0;
    background: var(--placeholder);
  }

  /* No photo: hold a 3:2 block, the shape of a landscape photo. */
  .fig:empty {
    aspect-ratio: 3 / 2;
  }

  /* The photo at its own ratio, never cropped: a fixed slot cut off heads (#33). */
  .fig :global(picture),
  .fig :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 26px;
    padding: 40px 80px;
  }

  .entry:nth-child(4n) .text {
    padding: 40px 44px 40px var(--gutter);
  }

  .text > * {
    margin: 0;
  }

  .nr {
    color: var(--ink-muted);
  }

  .name {
    font-size: 34px;
    font-weight: inherit;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .facts {
    line-height: 1.9;
  }

  .price {
    font-size: 22px;
    letter-spacing: 0.04em;
  }

  .blurb {
    color: var(--ink-muted);
    max-width: 360px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: var(--tap);
    box-sizing: border-box;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--ink);
    align-self: flex-start;
  }

  @media (max-width: 720px) {
    /* The date does not fit beside the label at 390; the board drops it. */
    .as-of {
      display: none;
    }

    .entry,
    .entry:nth-child(n) {
      align-items: stretch;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      grid-template-areas: 'fig' 'text';
    }

    .text,
    .entry:nth-child(n) .text {
      gap: 11px;
      padding: 20px var(--gutter-mobile) 28px;
    }

    /* The 390 board numbers no entry. */
    .nr {
      display: none;
    }

    .blurb {
      max-width: none;
    }

    .name {
      font-size: 24px;
      letter-spacing: 0.14em;
    }

    .price {
      font-size: 18px;
    }
  }
</style>
