---
/*
 * The horse gallery (E3.5): a two-column grid of thumbnails and one <dialog>
 * that shows them full size. With JavaScript off each thumbnail is a link to
 * the full image, built into dist/ — never the Storage URL, which visitors do
 * not read (E2.5). With it on, showModal() gives the focus trap, Escape and
 * inertness; the script adds open-at-the-photo, left/right on desktop and
 * focus restore.
 *
 * Every photo sits in the dialog as a figure with a lazy <img>, in one
 * scroll-snap list (E3.7): a vertical scroll on desktop, a horizontal carousel
 * with swipe under 720 px — CSS only, no touch code. A closed dialog renders
 * nothing, and opening it jumps straight to the clicked photo, so the photos
 * in between are skipped. The list takes focus on open, so the arrow keys
 * along its axis scroll it natively and the snap moves one photo per press.
 *
 * ponytail: the browser's lazy loading decides what loads, and Chrome fetches
 * about two photos either side of the one on screen. Swap `src` in from an
 * IntersectionObserver rooted on the list if that weight ever matters, but the
 * 1 KB budget has no room for it today (#154). The scroll lock is CSS: body
 * `overflow: hidden` plus `overscroll-behavior: contain`. If iOS Safari still
 * rubber-bands the page behind, swap in the position:fixed scroll-offset dance,
 * the same upgrade MenuDrawer names.
 */
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { photoUrl } from '../firebase';
import { t, type Locale } from '../i18n';
import type { Horse } from '../horse';

interface Props {
  photos: Horse['photos'];
  locale: Locale;
}
const { photos, locale } = Astro.props;
const dict = t(locale);

const full = await Promise.all(
  photos.map((photo) => getImage({ src: photoUrl(photo.key), inferSize: true, format: 'webp' })),
);
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<ul class="gallery">
  {photos.map((photo, i) => (
    <li>
      <a class="gallery-thumb" href={full[i].src}>
        <Photo photo={photo} locale={locale} sizes="50vw" />
      </a>
    </li>
  ))}
</ul>

<dialog id="hv-gallery" class="lightbox" aria-label={dict.gallery.preview}>
  <form method="dialog">
    <button type="submit" class="lightbox-close" aria-label={dict.gallery.close}>
      <span aria-hidden="true">×</span>
    </button>
  </form>
  <div class="lightbox-slides" tabindex="-1" autofocus>
    {photos.map((photo, i) => (
      <figure>
        <Photo photo={photo} locale={locale} sizes="(max-width: 1160px) 100vw, 1120px" />
        <figcaption class="lbl num">
          {[number(i), photo.caption[locale]].filter(Boolean).join(' · ')}
        </figcaption>
      </figure>
    ))}
  </div>
</dialog>

<script>
  const dialog = document.getElementById('hv-gallery') as HTMLDialogElement | null;

  if (dialog?.showModal) {
    const thumbs = document.querySelectorAll<HTMLAnchorElement>('.gallery-thumb');
    const slides = dialog.querySelector<HTMLElement>('.lightbox-slides')!;
    let at = 0;

    // Each figure is exactly one page of the scroller, so the page is the photo. Kept
    // here because by the time `close` fires the dialog has no size to measure.
    // `on*` properties, not addEventListener: this script owns these elements, and
    // the bytes saved pay for the arrow keys below.
    slides.onscroll = () => {
      at = Math.round(
        slides.scrollTop / slides.clientHeight + slides.scrollLeft / slides.clientWidth,
      );
    };

    // The focused list already scrolls along its own axis. Left and right also page
    // the vertical desktop list; on a phone the list has no height to page, so this is a no-op.
    dialog.onkeydown = (event) => {
      const step = ({ ArrowRight: 1, ArrowLeft: -1 } as Record<string, number>)[event.key];
      if (step) slides.scrollBy(0, step * slides.clientHeight);
    };

    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', (event) => {
        // Let modified clicks still open the full image in a new tab.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        dialog.showModal();
        // Instant, never smooth: a smooth scroll would pass, and so fetch, every photo in between.
        slides.children[(at = i)].scrollIntoView();
      }),
    );

    // Explicit, because Safari never focuses a clicked link, so the dialog's own
    // restore would land on <body>. The last photo viewed keeps the visitor's place.
    dialog.onclose = () => thumbs[at].focus();
  }
</script>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
  }

  .gallery-thumb {
    display: block;
    height: 470px;
    background: var(--ground-light);
  }

  .gallery-thumb :global(img),
  .lightbox :global(img) {
    width: 100%;
    height: 100%;
  }

  .gallery-thumb :global(img) {
    object-fit: cover;
  }

  /* The scroll lock, in CSS so it costs the script nothing. */
  :global(body:has(#hv-gallery[open])) {
    overflow: hidden;
  }

  .lightbox {
    border: 0;
    padding: 0;
    margin: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: rgba(14, 14, 13, 0.94);
    color: var(--ink-inv);
  }

  /* Every figure is one page of the scroller — the script reads the page as the photo. */
  .lightbox-slides {
    display: grid;
    grid-auto-rows: 100%;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-snap-type: y mandatory;
  }

  .lightbox figure {
    margin: 0;
    padding: 20px var(--gutter-mobile);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-width: 0;
    scroll-snap-align: start;
  }

  .lightbox :global(picture) {
    display: block;
    width: min(1120px, 100%);
    height: min(700px, calc(100dvh - 120px));
    background: #1e1e1b;
  }

  .lightbox :global(img) {
    object-fit: contain;
  }

  .lightbox figcaption {
    color: var(--ink-inv-muted);
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: 12px;
    right: var(--gutter-mobile);
    z-index: 1;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    text-align: center;
    font-size: 32px;
    line-height: 1;
    color: var(--ink-inv);
  }

  @media (max-width: 720px) {
    .gallery-thumb {
      height: 190px;
    }

    .lightbox-slides {
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      overflow: auto hidden;
      scroll-snap-type: x mandatory;
    }

    /* A phone is narrower than the photo is wide, so the box takes the photo's height. */
    .lightbox :global(picture),
    .lightbox :global(img) {
      height: auto;
      max-height: calc(100dvh - 120px);
    }
  }
</style>
