---
/*
 * One horse (E4.4), drawn as `HorseDetail` and `MobileDetail`: hero, sales
 * video, facts, the uncut round, suitability, health, gallery, viewing and the
 * other horses. A video or a gallery with nothing to show is left out (E4.5).
 * The enquiry, with this horse preselected, is the page's inverted band (E5.2),
 * and at 390 too: no script could carry the horse to the enquiry page.
 *
 * A sold horse keeps its URL for good, because WhatsApp links circulate for
 * years (E2.8). Its page is the trimmed state on `HorseDetailSold` /
 * `MobileDetailSold`: the hero with the sold label, the dark band to the horses
 * still for sale, the new-horse signup (E5.9), and the other horses. The price, the facts, the health record
 * and the X-rays belong to the new owner and are not rendered.
 */
import { getImage, inferRemoteSize } from 'astro:assets';
import Page from '../layouts/Page.astro';
import SubBar from './SubBar.astro';
import Photo from './Photo.astro';
import Video from './Video.astro';
import Gallery from './Gallery.astro';
import EnquiryForm from './EnquiryForm.astro';
import NotifyForm from './NotifyForm.astro';
import JsonLd from './JsonLd.astro';
import { t, type Locale } from '../i18n';
import { fill, formatDate, formatPrice, formatSize, plural } from '../i18n/format';
import { path } from '../i18n/routes';
import { photoUrl } from '../firebase';
import { media } from '../media';
import { livejumpingHref, site, whatsappHref } from '../site';
import type { Horse } from '../horse';

interface Props {
  locale: Locale;
  slug: string;
  horse: Horse;
}
const { locale, slug, horse } = Astro.props;
const dict = t(locale);
const d = dict.detail;
const sex = dict.pages.horses.sex;
const sold = horse.status === 'sold' && dict.sold[horse.sex];
const priceOf = (price: number | null) =>
  price === null ? dict.pages.horses.onRequest : formatPrice(locale, price);
const price = priceOf(horse.price);
const f = horse.facts;
const url = new URL(path(locale, 'horse', slug), Astro.site).href;
const cta = whatsappHref(fill(d.prefill, { name: horse.name, url }));

/*
 * The board's two columns of six, each closed by one of the sale rows (#2, #3).
 * A third slot links the value out; only Starts has one, to livejumping (#111).
 */
const factColumns: [string, string, string?][][] = [
  [
    [d.rows.pedigree, horse.pedigree],
    [d.rows.breeding, f.breeding[locale]],
    [d.rows.trainingLevel, f.trainingLevel[locale]],
    [d.rows.level, `${horse.levelCm} cm`],
    [d.rows.lastStart, f.lastStart?.[locale] ?? d.infoOnRequest],
    [
      d.rows.starts,
      f.starts?.[locale] ?? d.infoOnRequest,
      horse.livejumpingName ? livejumpingHref(horse.livejumpingName) : undefined,
    ],
    [d.rows.price, price],
  ],
  [
    [d.rows.technique, f.technique[locale]],
    [d.rows.rideability, f.rideability[locale]],
    [d.rows.temperament, f.temperament[locale]],
    [d.rows.handling, f.handling[locale]],
    [d.rows.location, f.location[locale]],
    [d.rows.documents, f.documents[locale]],
    [d.rows.sale, d.saleKind[horse.seller]],
  ],
];

/* ponytail: the first of each kind, as the boards draw one of each. */
const salesVideo = horse.videos.find((v) => v.kind === 'sales');
const roundVideo = horse.videos.find((v) => v.kind === 'round');

const xrays = horse.xrays;
const xrayDate = xrays && formatDate(locale, xrays.takenOn);

/*
 * The link preview card (E6.2): WhatsApp runs no JavaScript, drops an image over
 * about 300 KB, and caches a card for weeks. The hashed file name changes with
 * the photo, so a new cover is a new URL. `npm run links` holds the size.
 * sharp never upscales, so a cover under 1200 × 630 gets a smaller card of the
 * same shape, and the og:image size tags say what was built.
 *
 * ponytail: centre crop. Store a focal point per photo if a card ever cuts off a head.
 */
const cover = horse.photos[0];
let image;
if (cover) {
  const src = photoUrl(cover.key);
  const size = await inferRemoteSize(src);
  const scale = Math.min(1, size.width / 1200, size.height / 630);
  const [width, height] = [Math.floor(1200 * scale), Math.floor(630 * scale)];
  const card = await getImage({ src, width, height, fit: 'cover', format: 'jpg', quality: 80 });
  image = { src: new URL(card.src, Astro.site).href, width, height, alt: cover.alt[locale] };
}

/*
 * Structured data (E6.3). The breadcrumb is the visible one. The Product goes out
 * only with a price and only unsold: a priceless Offer is invalid (#2), a Product
 * without one is invalid too, and a sold horse shows no price (#23). The price is
 * the gross figure the page shows; a structured price that disagrees with the
 * visible one is a manual action. The seller is the home page's LocalBusiness.
 */
const horsesUrl = new URL(path(locale, 'horses'), Astro.site).href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: dict.nav.horses, item: horsesUrl },
    { '@type': 'ListItem', position: 2, name: horse.name, item: url },
  ],
};
const product = !sold &&
  horse.price !== null && {
    '@type': 'Product',
    name: horse.name,
    description: horse.headline[locale],
    url,
    ...(horse.photos.length && { image: horse.photos.map((p) => photoUrl(p.key)) }),
    offers: {
      '@type': 'Offer',
      price: horse.price,
      priceCurrency: 'EUR',
      availability: `https://schema.org/${horse.status === 'reserved' ? 'Reserved' : 'InStock'}`,
      url,
      /* One business across both locales, so the id is the Polish home page, as x-default is. */
      seller: { '@id': `${new URL(path('pl', 'home'), Astro.site).href}#business` },
    },
  };

/*
 * ponytail: three, as the row is drawn, in the editor's order. A sold horse is
 * never listed (#23). An "all horses" link if the stable ever outgrows a row.
 */
const others = site.horsesListed.filter((h) => h.slug !== slug).slice(0, 3);
---

<Page
  locale={locale}
  routeKey="horse"
  slug={slug}
  title={`${horse.name} — ${dict.brand.name}`}
  description={horse.headline[locale]}
  headerLinks={['horses', 'enquiry']}
  header="overlay"
  bar={sold ? undefined : cta}
  image={image}
  barForm={`${path(locale, 'horse', slug)}#enquiry`}
>
  <JsonLd data={breadcrumb} />
  {product && <JsonLd data={product} />}
  <section class:list={['hero', { 'hero-barred': !sold }]}>
    {horse.photos[0] && (
      <Photo
        photo={horse.photos[0]}
        locale={locale}
        sizes="100vw"
        hero
        phone={horse.phoneCover}
        class="hero-img"
      />
    )}
    <div class="hero-veil">
      <a class="hero-cue" href="#details">
        <span class="visually-hidden">{d.scrollCue}</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 16 22"
          width="48"
          height="66"
          fill="none"
          stroke="currentColor"
          stroke-width="0.8"
        >
          <path d="M2 2l6 5 6-5" />
          <path d="M2 8l6 5 6-5" />
          <path d="M2 14l6 5 6-5" />
        </svg>
      </a>
    </div>
    <div class="hero-text">
      <div class="hero-id">
        <h1 class="hero-name">{horse.name}</h1>
        <p class="meta hero-meta">
          {[
            horse.born,
            `${horse.heightCm} cm`,
            sex[horse.sex],
            horse.breed,
            `${horse.levelCm} cm`,
          ].join(' · ')}
        </p>
      </div>
      {sold ? (
        <p class="hero-price">{sold}</p>
      ) : (
        <div class="hero-offer fade-late">
          <p class="num hero-price">{price}</p>
          <a class="lbl hero-cta" href={cta}>
            {fill(d.cta[horse.sex], { name: horse.name })}
          </a>
        </div>
      )}
    </div>
  </section>
  <script>
    /*
     * The scroll cue (E4.19) shows only to a visitor who has stayed at the top
     * for four seconds, and goes for good on the first scroll — a back-button
     * restore and the cue's own jump included.
     */
    const hero = document.querySelector('.hero')!;
    let moved = scrollY > 0;
    addEventListener(
      'scroll',
      () => {
        moved = true;
        hero.classList.remove('cue-on');
      },
      { once: true, passive: true },
    );
    setTimeout(() => moved || hero.classList.add('cue-on'), 4000);
  </script>
  <SubBar id="details">
    <p slot="label" class="lbl crumb">
      <a href={path(locale, 'horses')}>{dict.nav.horses}</a>
      <span aria-hidden="true">/</span>
      {horse.name}
    </p>
    <p class="meta num subbar-meta">{sold || price}</p>
  </SubBar>

  {sold ? (
    <>
      <section class="sold">
        <h2 class="lbl sold-label">{sold}</h2>
        <p class="sold-line">{fill(dict.sold.line, { name: horse.name })}</p>
        <a class="lbl num sold-link" href={path(locale, 'horses')}>
          {fill(dict.sold.link, { count: site.horsesAvailable })}
          <span aria-hidden="true">&#8594;</span>
        </a>
      </section>
      <NotifyForm locale={locale} />
    </>
  ) : (
    <>
      {salesVideo && (
        <section class="band">
          <Video video={salesVideo} locale={locale} horse={horse} />
        </section>
      )}
      <section class="band">
        <h2 class="lbl head">{d.facts}</h2>
        <div class="cols">
          {factColumns.map((rows) => (
            <dl class="rows">
              {rows.map(([label, value, href]) => (
                <div>
                  <dt class="lbl">{label}</dt>
                  <dd class="num">
                    {value}
                    {href && (
                      <a class="lbl fact-link" href={href} target="_blank" rel="noopener">
                        <span>
                          {d.livejumping.link}
                          <span class="visually-hidden"> {d.livejumping.newTab}</span>
                        </span>
                        <span aria-hidden="true">&#8599;</span>
                      </a>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          ))}
        </div>
      </section>
      {roundVideo && (
        <section class="band">
          <Video video={roundVideo} locale={locale} horse={horse} />
        </section>
      )}
      <section class="band cols">
        <div class="ruled">
          <h2 class="lbl head">{d.suits}</h2>
          <ul class="list">
            {horse.suits.map((item) => (
              <li class="copy">{item[locale]}</li>
            ))}
          </ul>
        </div>
        <div class="ruled">
          <h2 class="lbl head">{d.notFor}</h2>
          <ul class="list">
            {horse.notFor.map((item) => (
              <li class="copy">{item[locale]}</li>
            ))}
          </ul>
        </div>
      </section>
      <section class="band">
        <h2 class="lbl head">{d.health}</h2>
        <div class="cols">
          <dl class="rows">
            <div>
              <dt class="lbl">{d.rows.vaccinations}</dt>
              <dd>{horse.health.vaccinations[locale]}</dd>
            </div>
            <div>
              <dt class="lbl">{d.rows.dewormedOn}</dt>
              <dd class="num">{formatDate(locale, horse.health.dewormedOn)}</dd>
            </div>
          </dl>
          <dl class="rows">
            {xrays && (
              <div>
                <dt class="lbl">{d.rows.xrays}</dt>
                <dd class="num">
                  {fill(d.xrays.summary, {
                    films: plural(locale, d.xrays.films, xrays.count),
                    date: xrayDate!,
                    scope: xrays.scope[locale],
                  })}
                  {xrays.files.length === 0 ? (
                    <span class="xray-pending">{d.xrays.pending}</span>
                  ) : (
                    xrays.files.map((file) => (
                      <a
                        class="lbl fact-link"
                        href={`${media.base}/${file.key}`}
                        download
                        data-event="xray_download"
                        data-horse={slug}
                      >
                        <span aria-hidden="true">&#8595;</span>
                        <span>
                          {d.xrays.download}
                          <span class="visually-hidden">
                            {' '}
                            {fill(d.xrays.downloadDate, { date: xrayDate! })}
                          </span>{' '}
                          PDF{file.label?.[locale] && ` · ${file.label[locale]}`} ·{' '}
                          {formatSize(locale, file.bytes)}
                        </span>
                      </a>
                    ))
                  )}
                </dd>
              </div>
            )}
            <div>
              <dt class="lbl">{d.rows.knownIssues}</dt>
              <dd>{horse.health.knownIssues[locale]}</dd>
            </div>
          </dl>
        </div>
        <p class="copy note">{d.vetNote}</p>
      </section>
      {horse.photos.length > 0 && (
        <section class="band">
          <h2 class="lbl head">{d.gallery}</h2>
          <Gallery photos={horse.photos} locale={locale} />
        </section>
      )}
      <section class="band">
        <h2 class="lbl head">{d.viewing}</h2>
        <div class="cols cols-3">
          {(
            [
              [d.rows.lead, horse.viewing.lead],
              [d.rows.airport, horse.viewing.airport],
              [d.rows.visitDay, horse.viewing.visitDay],
            ] as const
          ).map(([label, value]) => (
            <div class="ruled">
              <h3 class="lbl head">{label}</h3>
              <p class="copy">{value[locale]}</p>
            </div>
          ))}
        </div>
      </section>
      <section class="enquire dk" id="enquiry">
        <div class="enquire-intro">
          <div>
            <h2 class="lbl enquire-label">
              {fill(d.enquiry.heading[horse.sex], { name: horse.name })}
            </h2>
            <p class="enquire-lead">{d.enquiry.lead}</p>
          </div>
          <p class="copy num enquire-meta">
            {[horse.name, horse.born, `${horse.heightCm} cm`, `${horse.levelCm} cm`, price].join(
              ' · ',
            )}
          </p>
        </div>
        <EnquiryForm locale={locale} horse={slug} dark />
      </section>
    </>
  )}

  {others.length > 0 && (
    <section class="band">
      <h2 class="lbl head">{d.others}</h2>
      <ul class="others">
        {others.map((other) => (
          <li>
            <a class="card" href={path(locale, 'horse', other.slug)}>
              <figure class="thumb">
                {other.photos[0] && (
                  <Photo
                    photo={other.photos[0]}
                    locale={locale}
                    sizes="(max-width: 720px) 74px, 33vw"
                  />
                )}
              </figure>
              <div class="card-text">
                <h3 class="card-name">{other.name}</h3>
                <p class="meta card-meta">
                  {[other.born, `${other.heightCm} cm`, sex[other.sex], `${other.levelCm} cm`].join(
                    ' · ',
                  )}
                </p>
                <p class="num card-price">{priceOf(other.price)}</p>
              </div>
              <span class="card-arrow" aria-hidden="true">
                &#8594;
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Page>

<style>
  /* ---- Hero: the header floats on it, the text sits on a scrim ---- */

  /*
   * At 390 the sticky WhatsApp bar (MobileBar, 81px) sits over the hero's foot
   * on a horse for sale, so its text is padded clear of it (#149).
   */

  .hero {
    position: relative;
    height: min(900px, 100svh);
    min-height: 560px;
    background: var(--ground-dark);
    color: var(--ink-inv);
    overflow: hidden;
  }

  .hero :global(picture),
  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * The boards draw no scrim; the homepage decision applies (E1.10). --ink-inv
   * needs --scrim under it on a white frame, so the gradient is solid for the
   * full height of the text and only fades above it.
   */
  .hero-text {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 60px;
    padding: 160px var(--gutter) 56px;
    background: linear-gradient(0deg, var(--scrim) 0, var(--scrim) calc(100% - 120px), transparent);
  }

  .hero-text p {
    margin: 0;
  }

  .hero-name {
    margin: 0 0 18px;
    font-size: 62px;
    font-weight: inherit;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
  }

  .hero-offer {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .hero-price {
    font-size: 30px;
    letter-spacing: 0.04em;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: 19px 36px;
    box-sizing: border-box;
    background: var(--ink-inv);
    color: var(--ground-dark);
  }

  /*
   * The scroll cue (E4.19): a visitor who is still at the top after a few
   * seconds gets the photo dimmed and a large link past the hero in its middle.
   * The script below adds `.cue-on` and takes it away on the first scroll; with
   * no JavaScript the cue never shows and the page reads as it always did. The
   * veil sits under the hero text, so the name and the offer stay on top.
   * Motion is fades only: the chevrons pulse top to bottom. Negative delays
   * start them mid-cycle, and base.css cuts the loop under reduced motion,
   * leaving them static and solid.
   */
  .hero-veil {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(14 14 13 / 0.4);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.8s ease-out,
      visibility 0.8s;
  }

  .cue-on .hero-veil {
    opacity: 1;
    visibility: visible;
  }

  /* The drop shadow holds the chevrons at 3:1 on a pale photo, through the veil. */
  .hero-cue {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    filter: drop-shadow(0 0 8px rgb(14 14 13 / 0.6));
  }

  .hero-cue path {
    animation: hero-cue 1.8s ease-in-out infinite;
  }

  .hero-cue path:nth-child(1) {
    animation-delay: -0.4s;
  }

  .hero-cue path:nth-child(2) {
    animation-delay: -0.2s;
  }

  @keyframes hero-cue {
    0%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }

  /* Smooth only on this page, and only for visitors who have not asked for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.hero-cue)) {
      scroll-behavior: smooth;
    }
  }

  .crumb {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .crumb a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink-muted);
  }

  .subbar-meta {
    margin: 0;
    color: var(--ink-muted);
  }

  /* ---- Sections ---- */

  .band {
    padding: 80px var(--gutter);
  }

  .band + .band {
    padding-top: 0;
  }

  .head {
    margin: 0 0 32px;
    font-weight: inherit;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 80px;
  }

  .cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 60px;
  }

  .ruled {
    border-top: 1px solid var(--ink);
    padding-top: 28px;
  }

  .ruled p {
    margin: 0;
  }

  .rows {
    margin: 0;
  }

  .rows > div {
    display: flex;
    gap: 28px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }

  .rows > div:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .rows dt {
    width: 200px;
    flex-shrink: 0;
    padding-top: 3px;
    color: var(--ink-muted);
  }

  .rows dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .xray-pending {
    display: block;
    margin-top: 12px;
    color: var(--ink-muted);
  }

  .fact-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    box-sizing: border-box;
    margin-top: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
  }

  .note {
    margin: 32px 0 0;
    max-width: 720px;
    color: var(--ink-muted);
  }

  /* ---- Other horses: cards at 1440, rows at 390 ---- */

  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .thumb {
    margin: 0;
    height: 300px;
    overflow: hidden;
    background: var(--placeholder);
  }

  .thumb :global(picture),
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .card-text > * {
    margin: 0;
  }

  .card-name {
    font-size: 20px;
    font-weight: inherit;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card-meta {
    color: var(--ink-muted);
  }

  .card-price {
    font-size: 16px;
  }

  .card-arrow {
    display: none;
  }

  /* ---- Enquiry: a live horse's one inverted band ---- */

  .enquire {
    background: var(--ground-dark);
    color: var(--ink-inv);
    padding: 84px var(--gutter) 90px;
  }

  .enquire-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 60px;
    margin-bottom: 48px;
  }

  .enquire-label {
    margin: 0 0 16px;
    font-weight: inherit;
    color: var(--ink-inv-muted);
  }

  .enquire-lead {
    margin: 0;
    font-size: 30px;
    letter-spacing: -0.01em;
  }

  .enquire-meta {
    max-width: 320px;
    margin: 0;
    color: var(--ink-inv-muted);
  }

  /* ---- Sold: the page's one inverted band ---- */

  .sold {
    background: var(--ground-dark);
    color: var(--ink-inv);
    padding: 84px var(--gutter) 90px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 60px;
  }

  .sold + :global(.notify) + .band {
    padding-top: 80px;
  }

  .sold-label {
    flex-basis: 100%;
