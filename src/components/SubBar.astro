---
/*
 * The 56px band under the header: what this page is, on the left. Without a
 * `label` the page's h1 lives elsewhere (the horse detail hero) and the left
 * side is only the `label` slot.
 */
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<div class="subbar">
  <div class="subbar-left">
    <!-- The sub-bar label is the page title, so it is the page's one h1. -->
    {label && <h1 class="lbl subbar-label">{label}</h1>}
    <slot name="label" />
  </div>
  <div class="subbar-right">
    <slot />
  </div>
</div>

<style>
  .subbar {
    min-height: var(--subbar-h);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 8px var(--gutter);
  }

  .subbar-label {
    margin: 0;
    font-weight: inherit;
  }

  .subbar-left,
  .subbar-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  @media (max-width: 720px) {
    .subbar {
      padding-inline: var(--gutter-mobile);
    }
  }
</style>
