---
/*
 * Ticket 4.4/4.5 fill this page. It exists now so the homepage's bottom-edge
 * horse line — one of the three ways off the homepage — is not a dead link.
 *
 * A sold horse keeps its URL for good, because WhatsApp links circulate for
 * years (E2.8). Its page is the trimmed state on `HorseDetailSold` /
 * `MobileDetailSold`: no price, no X-rays, no enquiry for this horse, and a way
 * to the horses still for sale. E4.4 adds the hero and the other-horses cards
 * to it and keeps everything else out.
 */
import Page from '../layouts/Page.astro';
import SubBar from './SubBar.astro';
import { t, type Locale } from '../i18n';
import { fill } from '../i18n/format';
import { path } from '../i18n/routes';
import { site } from '../site';
import type { Horse } from '../horse';

interface Props {
  locale: Locale;
  slug: string;
  horse: Horse;
}
const { locale, slug, horse } = Astro.props;
const dict = t(locale);
const sold = horse.status === 'sold' && dict.sold[horse.sex];
---

<Page
  locale={locale}
  routeKey="horse"
  slug={slug}
  title={`${horse.name} — ${dict.brand.name}`}
  description={dict.pages.horses.description}
  headerLinks={['horses', 'enquiry']}
>
  <SubBar label={horse.name}>{sold && <p class="meta sold-meta">{sold}</p>}</SubBar>
  {sold ? (
    <section class="sold">
      <h2 class="lbl sold-label">{sold}</h2>
      <p class="sold-line">{fill(dict.sold.line, { name: horse.name })}</p>
      <a class="lbl num sold-link" href={path(locale, 'horses')}>
        {fill(dict.sold.link, { count: site.horsesAvailable })}
        <span aria-hidden="true">&#8594;</span>
      </a>
    </section>
  ) : (
    <section class="stub">
      <!-- Ticket 4.4 — hero, fact table, suitability, health, viewing, other horses. -->
      <!-- Ticket 4.5 — sales video, full round, gallery lightbox. -->
      <p class="copy">4.4 / 4.5</p>
    </section>
  )}
</Page>

<style>
  .stub {
    padding: 80px var(--gutter);
    color: var(--ink-muted);
  }

  .sold-meta {
    margin: 0;
    color: var(--ink-muted);
  }

  /* The page's one inverted band — the action is now the horses still for sale. */
  .sold {
    background: var(--ground-dark);
    color: var(--ink-inv);
    padding: 84px var(--gutter) 90px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 60px;
  }

  .sold-label {
    flex-basis: 100%;
    margin: 0;
    font-weight: inherit;
    color: var(--ink-inv-muted);
  }

  .sold-line {
    margin: 0;
    font-size: 30px;
    letter-spacing: -0.01em;
  }

  .sold-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 44px;
    padding: 19px 36px;
    box-sizing: border-box;
    background: var(--ink-inv);
    color: var(--ground-dark);
  }

  @media (max-width: 720px) {
    .sold {
      padding: 30px var(--gutter-mobile) 34px;
    }

    .sold-line {
      font-size: 21px;
      line-height: 1.25;
    }

    .sold-link {
      flex-basis: 100%;
      min-height: 52px;
      padding: 0;
    }
  }
</style>
