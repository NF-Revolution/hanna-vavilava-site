---
/* The enquiry page (E5.1): the heading, the reply promise and the eight-field form. */
import Page from '../layouts/Page.astro';
import SubBar from './SubBar.astro';
import EnquiryForm from './EnquiryForm.astro';
import { t, type Locale } from '../i18n';
import { fill } from '../i18n/format';
import { site } from '../site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const page = t(locale).pages.enquiry;
const hours = { hours: site.responseWindow };
---

<Page locale={locale} routeKey="enquiry" title={page.title} description={page.description}>
  <SubBar label={page.label}>
    <p class="meta sub-meta">{fill(page.meta, hours)}</p>
  </SubBar>

  <section class="enquiry-page">
    <div class="intro">
      <h2 class="heading">{page.heading}</h2>
      <p class="copy lead">{fill(page.lead, hours)}</p>
    </div>
    <EnquiryForm locale={locale} />
  </section>
</Page>

<style>
  .sub-meta {
    margin: 0;
    color: var(--ink-muted);
  }

  .enquiry-page {
    padding: 72px var(--gutter) 80px;
  }

  .intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 52px;
  }

  .heading {
    max-width: 680px;
    margin: 0;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .lead {
    max-width: 340px;
    margin: 0;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .enquiry-page {
      padding: 36px var(--gutter-mobile) 48px;
    }

    .intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 36px;
    }

    .heading {
      font-size: 28px;
    }
  }
</style>
