---
/*
 * About (E4.6): the portrait beside the bio and its script signature, the five
 * buying steps, and the dark band. The portrait sits in a 3:4 column, not the
 * board's first 1440 × 620 band: the photo is portrait and the band cut it to
 * the rider's torso (#36).
 */
import { Picture } from 'astro:assets';
import Page from '../layouts/Page.astro';
import SubBar from './SubBar.astro';
import CtaBand from './CtaBand.astro';
import portrait from '../assets/about/hanna.jpg';
import { t, type Locale } from '../i18n';
import { fill, plural } from '../i18n/format';
import { path } from '../i18n/routes';
import { site, stables } from '../site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const page = dict.pages.about;

/*
 * The map (#165) loads on click: Google's cookies need consent (ePrivacy art.
 * 5(3)), so the frame starts as a placeholder of our own whose one link navigates
 * it to Google. No JS, no banner, and Google sees nothing until the press. The
 * pin is the coordinates, not the address — the gate is on ul. Długa.
 * ponytail: the keyless `output=embed` URL is undocumented (it 301s to
 * `/maps/embed?pb=…`); if it breaks, the Maps Embed API with a referrer-restricted
 * key is the upgrade, and the place link beside the frame works meanwhile.
 */
const mapSrc = `https://www.google.com/maps?q=${stables.lat},${stables.lng}&z=14&hl=${locale}&output=embed`;
const mapPlaceholder =
  '<!doctype html><meta name="referrer" content="no-referrer-when-downgrade"><style>' +
  "@font-face{font-family:Archivo;font-weight:300 500;src:url(/fonts/archivo-latin-ext.woff2) format('woff2')}" +
  "@font-face{font-family:Archivo;font-weight:300 500;src:url(/fonts/archivo-latin.woff2) format('woff2');unicode-range:U+0000-00FF}" +
  'html,body,a{height:100%;margin:0}' +
  "body{background:#e9e8e3;color:#0e0e0d;font:15px/1.62 Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif}" +
  'a{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:20px;color:inherit;text-align:center;text-decoration:none}' +
  'a:focus-visible{outline:2px solid #0e0e0d;outline-offset:-6px}' +
  'b{font-weight:400;font-size:10px;letter-spacing:.24em;text-transform:uppercase;border:1px solid;padding:14px 28px}' +
  'a:hover b{background:#0e0e0d;color:#f2f1ed}' +
  'span{max-width:40ch;color:#6b6a64;font-size:13px}</style>' +
  `<a href="${mapSrc.replaceAll('&', '&amp;')}"><b>${page.map.load}</b><span>${page.map.note}</span></a>`;
---

<Page
  locale={locale}
  routeKey="about"
  title={page.title}
  description={page.description}
  headerLinks={['horses', 'faq', 'enquiry']}
>
  <SubBar label={page.label}>
    <p class="meta sub-meta">{page.meta}</p>
  </SubBar>

  <section class="intro">
    <Picture
      src={portrait}
      widths={[480, 960, portrait.width]}
      sizes="(max-width: 720px) calc(100vw - 40px), 480px"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      alt={page.portraitAlt}
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
    <div class="bio">
      <p>{page.bio}</p>
      <p class="signature">{dict.brand.name}</p>
    </div>
  </section>

  <section class="steps">
    <h2 class="lbl head">{page.stepsHead}</h2>
    <ol>
      {page.steps.map((step, i) => (
        <li>
          <span class="meta num step-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="lbl step-title">{step.title}</h3>
          <p class="copy step-text">
            {fill(step.text, { hours: site.responseWindow, stables: stables.name })}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section class="map">
    <div>
      <h2 class="lbl head">{page.map.head}</h2>
      <address class="copy">
        {stables.name}
        <br />
        {stables.street}
        <br />
        {stables.postalCode} {stables.town}
      </address>
      <a class="copy open" href={stables.mapsHref}>
        {page.map.open}
      </a>
    </div>
    <iframe
      title={fill(page.map.title, { stables: stables.name })}
      srcdoc={mapPlaceholder}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>

  <CtaBand
    locale={locale}
    line={`${plural(locale, page.band, site.horsesAvailable)} ${page.bandReply}`}
    href={path(locale, 'horses')}
    label={page.seeHorses}
  />
</Page>

<style>
  .sub-meta {
    margin: 0;
    color: var(--ink-muted);
  }

  /* ---- Portrait and bio ---- */

  /* The portrait gives way below 1200 so the bio keeps a readable measure. */
  .intro {
    display: grid;
    grid-template-columns: min(480px, 40%) minmax(0, 1fr);
    align-items: start;
    gap: 80px;
    padding: 48px var(--gutter) 60px;
  }

  .intro :global(picture) {
    display: block;
  }

  .portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--placeholder);
  }

  .bio {
    max-width: 760px;
    font-size: 17px;
    line-height: 1.7;
  }

  .bio p {
    margin: 0;
  }

  .bio .signature {
    margin-top: 40px;
    font-family: var(--font-script);
    font-size: 56px;
    line-height: 1;
  }

  /* ---- The five steps ---- */

  .steps {
    border-top: 1px solid var(--rule);
    padding: 68px var(--gutter) 80px;
  }

  .head {
    margin: 0 0 44px;
    font-weight: inherit;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 40px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }

  li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .step-num {
    flex: none;
    width: 60px;
    color: var(--ink-muted);
  }

  .step-title {
    flex: none;
    width: 320px;
    margin: 0;
    font-weight: inherit;
  }

  .step-text {
    max-width: 640px;
    margin: 0;
    color: var(--ink-muted);
  }

  /* ---- The map ---- */

  /* The intro's columns: the address under the portrait, the map under the bio. */
  .map {
    display: grid;
    grid-template-columns: min(480px, 40%) minmax(0, 1fr);
    align-items: start;
    gap: 80px;
    border-top: 1px solid var(--rule);
    padding: 68px var(--gutter) 80px;
  }

  address {
    margin: 0 0 16px;
    font-style: normal;
  }

  .open {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: underline;
  }

  /* A fixed ratio, so neither the placeholder nor Google's map shifts the page. */
  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--placeholder);
  }

  @media (max-width: 720px) {
    /* No room beside the label at 390, and the bio's first line says the same. */
    .sub-meta {
      display: none;
    }

    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 20px var(--gutter-mobile) 44px;
    }

    .bio {
      font-size: 16px;
    }

    .bio .signature {
      margin-top: 24px;
      font-size: 48px;
    }

    .steps {
      padding: 44px var(--gutter-mobile) 52px;
    }

    .head {
      margin-bottom: 28px;
    }

    /* Number and title on one line, the text under them. */
    li {
      flex-wrap: wrap;
      gap: 10px 16px;
      padding: 20px 0;
    }

    .step-num {
      width: auto;
    }

    .step-title {
      width: auto;
      flex: 1;
    }

    .step-text {
      flex-basis: 100%;
    }

    .map {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 44px var(--gutter-mobile) 52px;
    }

    iframe {
      aspect-ratio: 4 / 3;
    }
  }
</style>
