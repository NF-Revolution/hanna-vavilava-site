---
/*
 * One footer, not three. The location, the contact details, the standing facts
 * and the language switch are written once here and appear once. Response time
 * is deliberately not repeated — it belongs to the dark conversion band that
 * sits above the footer on each page.
 */
import { t, htmlLang, type Locale } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { site, whatsappHref, telegramHref, emailHref, phoneHref } from '../site';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
}
const { locale, routeKey, slug } = Astro.props;
const dict = t(locale);
const other = locale === 'pl' ? 'en' : 'pl';

const pages: RouteKey[] = ['horses', 'about', 'faq', 'enquiry'];
const contacts = [
  { href: whatsappHref(), label: `${dict.menu.whatsapp} ${site.phone}` },
  { href: telegramHref, label: `${dict.menu.telegram} @${site.telegram}` },
  { href: phoneHref, label: `${dict.footer.phone} ${site.phone}` },
  { href: emailHref, label: site.email, lower: true },
];
---

<footer class="foot">
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="foot-wordmark" href={path(locale, 'home')}>
        {dict.brand.name}
      </a>
      <!-- PLACEHOLDER: replaced by the registered seller details in ticket 7.5. -->
      <p class="lbl foot-address">
        {dict.footer.stable}
        <br />
        {dict.footer.location}
      </p>
    </div>

    <nav class="foot-nav" aria-label={dict.a11y.navFooter}>
      {pages.map((key) => (
        <a class="lbl" href={path(locale, key)}>
          {dict.nav[key as 'horses']}
        </a>
      ))}
    </nav>

    <div class="foot-contact">
      {contacts.map((item) => (
        <a class:list={['lbl', item.lower && 'foot-mail']} href={item.href}>
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <div class="foot-bar">
    <p class="lbl foot-facts">
      {[dict.footer.languages, dict.footer.vetting, dict.footer.footage].join('   ·   ')}
    </p>
    <p class="lbl foot-langs">
      <span class="foot-lang-current">{locale.toUpperCase()}</span>
      <a
        class="foot-lang-other"
        href={path(other, routeKey, slug)}
        lang={htmlLang[other]}
        hreflang={htmlLang[other]}
      >
        {other.toUpperCase()}
      </a>
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ground-light);
    color: var(--ink);
    border-top: 1px solid var(--rule);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.1fr;
    gap: 60px;
    padding: 44px var(--gutter) 36px;
  }

  .foot-brand,
  .foot-nav,
  .foot-contact {
    display: flex;
    flex-direction: column;
  }

  .foot-brand {
    gap: 16px;
  }

  /*
   * 44px rows, not the board's 13px rows with a 13px gap. The board's own
   * note n4 asks for 44px minimum targets and its footer does not honour it;
   * the gap is absorbed into the row rather than added to it (E1.10).
   */
  .foot-nav,
  .foot-contact {
    gap: 0;
  }

  .foot-nav a,
  .foot-contact a,
  .foot-wordmark,
  .foot-lang-other {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    width: fit-content;
  }

  .foot-wordmark {
    font-size: 13px;
    letter-spacing: 0.44em;
    text-transform: uppercase;
  }

  .foot-address {
    margin: 0;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .foot-mail {
    text-transform: none;
  }

  .foot-bar {
    border-top: 1px solid var(--rule-hair);
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 12px var(--gutter);
  }

  .foot-facts {
    margin: 0;
    letter-spacing: 0.22em;
    color: var(--ink-muted);
  }

  .foot-langs {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    flex-shrink: 0;
  }

  .foot-lang-current {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px;
  }

  .foot-lang-other {
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .foot-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 36px var(--gutter-mobile) 28px;
    }

    .foot-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 20px var(--gutter-mobile) 28px;
    }

    .foot-facts {
      line-height: 2;
    }
  }
</style>
